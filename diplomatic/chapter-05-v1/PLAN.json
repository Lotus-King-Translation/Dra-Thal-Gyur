      "end": 149604,
      "chapter_sha256": "a2027212d5e8f1fa89a69e6e85dbb8b98226237b4f5aee229b4b9591500b55eb",
      "opening": "དེ་ནས་རང་བཞིན་རྣམ་དག་པས། །ཆོས་སྐུ་བརྗོད་པ་མེད་པ་ལས། །ཆོས་ཉིད་སྤྲོས་བྲལ་ནམ་མཁའ་ལས། །བརྗོད་དུ་མེད་པའི་གཞི་མ་ལས། །རང་བྱུང་བ",
      "closing": "་ཚོམ་མེད། །སོ་སོའི་རྟགས་དང་ངེས་སྦྱོར་བའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། ལྟ་སྒོམ་བཀོད་པ་གནས་པའི་རྩ་བ་བསྟན་པའི་ལེའུ་སྟེ་ལྔ་པའོ།། །།",
      "following": "དེ་ནས་ཆོས་ཀུན་བརྗོད་མེད་ཀྱང༌། །སེམས་ཅན་འཁྲུལ་རྟོག་དུ་མ་ལས། །སྒྲ་ཚིག་ཐ་སྙད་གཞི་མར་ཡང་། །བཅོས་པ་མེད་པའ"
    },
    "B": {
      "path": "editions/tharpaling-1983/W27491_7.txt",
      "full_sha256": "df05454b1ca21d893188b30e00b7b463abe369afc6ec26d917354a7d6de464c3",
      "start": 137817,
      "end": 150310,
      "chapter_sha256": "7c996e78cd6c31a958cc51c37f6fd590ed3e63409052bd4f421ee23fb4eaf58d",
      "opening": "དེ་ནས་རང་བཞིན་རྣམ་དག་པས། །ཆོས་སྐུ་བརྗོད་པ་མེད་པ་ལས། །ཆོས་ཉིད་སྤྲོས་བྲལ་ནམ་མཁའ་ལས། །བརྗོད་དུ་མེད་པའི་གཞི་མ་ལས། །རང་བྱུང་བ",
      "closing": " །སོ་སོའི་རྟགས་དང་ངེས་སྦྱོར་བའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། ལྟ་སྒོམ་བཀོད་པ་གནས་པའི་རྩ་བ་བསྟན་པའི་ལེའུ་སྟེ་ལྔ་པའོ།། །།ཿམཐ་ཕགཿ །",
      "following": "དེ་ནས་ཆོས་ཀུན་བརྗོད་མེད་ཀྱང༌། །སེམས་ཅན་འཁྲུལ་རྟོག་དུ་མ་ལས། །སྒྲ་ཚིག་ཐ་སྙད་གཞི་མར་ཡང་། །བཅོས་པ་མེད་པའ"
    },
