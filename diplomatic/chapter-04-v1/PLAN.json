      "end": 137182,
      "chapter_sha256": "1890d0cee236ee397433f93a0a89c1cc5eb4bc96c40648e2f5c5da938d68079e",
      "opening": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །སྟོན་པ་ཁྱབ་བདག་ཆེན་པོ་ལ། །ཆོས་ཉིད་བཀོད་པའི་རང་བཞིན་ཞུས། །ཀྱེ་ཀྱེ་ཡང་དག་རྫོགས་སངས་རྒྱས། །བདག",
      "closing": "་བུ་བློ་བྲལ་ཉིད། །སྨྲ་བསམ་བརྗོད་པ་ཀུན་འདས་པའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། ཆོས་ཉིད་བཀོད་པ་སེམས་སྣང་གི་རྩ་བ་བསྟན་པའི་ལེའུ་སྟེ་བཞི་པའོ།། །།",
      "following": "དེ་ནས་རང་བཞིན་རྣམ་དག་པས། །ཆོས་སྐུ་བརྗོད་པ་མེད་པ་ལས། །ཆོས་ཉིད་སྤྲོས་བྲལ་ནམ་མཁའ་ལས། །བརྗོད་དུ་མེད་པའི་"
    },
    "B": {
      "path": "editions/tharpaling-1983/W27491_7.txt",
      "full_sha256": "df05454b1ca21d893188b30e00b7b463abe369afc6ec26d917354a7d6de464c3",
      "start": 124817,
      "end": 137817,
      "chapter_sha256": "54a3791740e0496acc188b1955a3f78a2414cbd2133104b4f2b097e065d1c637",
      "opening": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །སྟོན་པ་ཁྱབ་བདག་ཆེན་པོ་ལ། །ཆོས་ཉིད་བཀོད་པའི་རང་བཞིན་ཞུས། །ཀྱེ་ཀྱེ་ཡང་དག་རྫོགས་སངས་རྒྱས། །བདག",
      "closing": "བྲལ་ཉིད། །སྨྲ་བསམ་བརྗོད་པཔ་ཀུན་འདས་པའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། ཆོས་ཉིད་བཀོད་པ་སྣང་གི་རྩ་བ་བསྟན་པའི་ལེའུ་སྟེ་བཞི་པའོ།། །།ཐའཐང་རྦགཿ། །",
      "following": "དེ་ནས་རང་བཞིན་རྣམ་དག་པས། །ཆོས་སྐུ་བརྗོད་པ་མེད་པ་ལས། །ཆོས་ཉིད་སྤྲོས་བྲལ་ནམ་མཁའ་ལས། །བརྗོད་དུ་མེད་པའི་"
    },
    "S": {
      "path": "editions/sichuan-2016/W3CN7084_7.txt",
