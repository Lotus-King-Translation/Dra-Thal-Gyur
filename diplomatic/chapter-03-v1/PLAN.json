      "chapter_sha256": "4de5a1c26f3cd7ad5724d22e88b2b6891968622e62c1fe5e0040a53893f77997",
      "before": " །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། གནད་འདུས་བཀོད་པ་རིག་པའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གཉིས་པའོ།། །།",
      "opening": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །ཡེ་ཤེས་བཀོད་པ་ཞེས་བྱ་བའི། །སངས་རྒྱས་བཅོམ་ལྡན་འདས་ལ་ཞུས། །ཆོས་ཉིད་གནས་པ་ཇི་ལྟར་ལགས། །དེ་ལས་འ",
      "closing": "ང་བཞིན་དག་པས་སྐུ་གསུམ་བཞིའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། ཡེ་ཤེས་བཀོད་པ་སྣང་བའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གསུམ་པའོ།། །།ཿགཙར་འཉྲ་ཨཱཿ།།",
      "following": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །སྟོན་པ་ཁྱབ་བདག་ཆེན་པོ་ལ། །ཆོས་ཉིད་བཀོད་པའི་རང་བཞིན་ཞུས། །ཀྱེ་ཀྱེ་ཡང་དག་རྫོགས་སངས་རྒྱས། །བདག"
    },
