      "chapter_sha256": "5d2834eb909db79a795aee383d3071549a536a1f6e1445e0709147611c07b916",
      "before": "འོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། གནད་འདུས་བཀོད་པ་རིག་པའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གཉིས་པའོ།།",
      "opening": " དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །ཡེ་ཤེས་བཀོད་པ་ཞེས་བྱ་བའི། །སངས་རྒྱས་བཅོམ་ལྡན་འདས་ལ་ཞུས། །ཆོས་ཉིད་གནས་པ་ཇི་ལྟར་ལགས། །དེ་ལས་",
      "closing": "བ་པར་སྟོང་། །རང་བཞིན་དག་པས་སྐུ་གསུམ་བཞིའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། ཡེ་ཤེས་བཀོད་པ་སྣང་བའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གསུམ་པའོ།། །།",
      "following": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །སྟོན་པ་ཁྱབ་བདག་ཆེན་པོ་ལ། །ཆོས་ཉིད་བཀོད་པའི་རང་བཞིན་ཞུས། །ཀྱེ་ཀྱེ་ཡང་དག་རྫོགས་སངས་རྒྱས། །བདག"
    },
    "B": {
      "path": "editions/tharpaling-1983/W27491_7.txt",
      "full_sha256": "df05454b1ca21d893188b30e00b7b463abe369afc6ec26d917354a7d6de464c3",
