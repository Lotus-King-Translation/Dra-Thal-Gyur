      "chapter_sha256": "b4317c052c91291a6730681c57e4547cc2d979a4c1887e39d8ff0aab2c09bb75",
      "before": "ོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས།སྣ་ཚོགས་བཀོད་པ་རང་བྱུང་མན་ངག་གི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་དང་པོའོ།།  །།",
      "opening": "དེ་ནས་ལྷ་དབང་རྟོག་པ་མེད།།ཆོས་ཀྱི་དབྱིངས་དང་དབྱེར་མེད་ཀྱང་། །མ་འོངས་དུས་ཀྱི་སེམས་ཅན་ལ། །རྟོགས་པས་ངེས་པར་འཁོར་བ་ལས། །བསྒྲལ",
      "closing": "ད་གསུམ་གདར་ཤ་ཆོད་པའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས།གནད་འདུས་བཀོད་པ་རིག་པའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གཉིས་པའོ།། །།",
      "following": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །ཡེ་ཤེས་བཀོད་པ་ཞེས་བྱ་བའི། །སངས་རྒྱས་བཅོམ་ལྡན་འདས་ལ་ཞུས། །ཆོས་ཉིད་གནས་པ་ཇི་ལྟར་ལགས། །དེ་ལས་འ"
