      "chapter_sha256": "935ae880e4c5545419a2b74307d2d8920cf7bfe946bdae469f18bb4925c34c68",
      "before": "ོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས།སྣ་ཚོགས་བཀོད་པ་རང་བྱུང་མན་ངག་གི་རྩ་་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་དང་པོའོ།།",
      "opening": "དེ་ནས་ལྷ་དབང་རྟོག་པ་མེད།།ཆོས་ཀྱི་དབྱིངས་དང་དབྱེར་མེད་ཀྱང་། །མ་འོངས་དུས་ཀྱི་སེམས་ཅན་ལ། །རྟོགས་པས་ངེས་པར་འཁོར་བ་ལས། །བསྒྲལ",
      "closing": "ྲིད་གསུམ་གདར་ཤ་ཆོད་པའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། གནད་འདུས་བཀོད་པ་རིག་པའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གཉིས་པའོ།།",
      "following": " དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །ཡེ་ཤེས་བཀོད་པ་ཞེས་བྱ་བའི། །སངས་རྒྱས་བཅོམ་ལྡན་འདས་ལ་ཞུས། །ཆོས་ཉིད་གནས་པ་ཇི་ལྟར་ལགས། །དེ་ལས་"
    },
    "B": {
      "path": "editions/tharpaling-1983/W27491_7.txt",
      "full_sha256": "df05454b1ca21d893188b30e00b7b463abe369afc6ec26d917354a7d6de464c3",
      "start": 76794,
      "end": 105153,
      "chapter_sha256": "f3407524f8fe1629cafcbc05a1ed8b119fd389581db981639e0e8d49f1d205ec",
      "before": "་ལས། །སྣ་ཚོགས་བཀོད་པ་རང་བྱུང་མན་ངག་གི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་དང་པོའོ།།བྷྲམྱ་ཏྲ་ཧྲ་ཏྱ། །ཉྲཿ །",
      "opening": "དེ་ནས་ལྷ་དབང་རྟོག་པ་མེད།།ཆོས་ཀྱི་དབྱིངས་དང་དབྱེར་མེད་ཀྱང་། །མ་འོངས་དུས་ཀྱི་སེམས་ཅན་ལ། །རྟོགས་པས་ངེས་པར་འཁོར་བ་ལས། །བསྒྲལ",
      "closing": "་གསུམ་གདར་ཤ་ཆོད་པའོ། །ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས། གནད་འདུས་བཀོད་པ་རིག་པའི་རྩ་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་གཉིས་པའོ།། །།",
      "following": "དེ་ནས་ལྷ་དབང་དགའ་བྱེད་ཀྱིས། །ཡེ་ཤེས་བཀོད་པ་ཞེས་བྱ་བའི། །སངས་རྒྱས་བཅོམ་ལྡན་འདས་ལ་ཞུས། །ཆོས་ཉིད་གནས་པ་ཇི་ལྟར་ལགས། །དེ་ལས་འ"
    },
    "S": {
      "path": "editions/sichuan-2016/W3CN7084_7.txt",
      "full_sha256": "2cf6b52889211579dff68f2e064032f40926de266242f111b3c94bb4efa47c57",
