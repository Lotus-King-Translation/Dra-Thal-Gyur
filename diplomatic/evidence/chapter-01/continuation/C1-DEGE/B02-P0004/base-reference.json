      "source_tibetan": "བཅུད་ཀྱིས་ལེན་པ་ཇི་ལྟ་བུ། །",
      "reading_tibetan": "བཅུད་ཀྱིས་ལེན་པ་ཇི་ལྟ་བུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00254",
      "source_tibetan": "གོས་ནི་གང་གིས་འགྲུབ་པ་ལགས། །",
      "reading_tibetan": "གོས་ནི་གང་གིས་འགྲུབ་པ་ལགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00255",
      "source_tibetan": "འབྱུང་བའི་རྒྱུན་ནི་ཅི་ལྟར་གཅད། །",
      "reading_tibetan": "འབྱུང་བའི་རྒྱུན་ནི་ཅི་ལྟར་གཅད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00256",
      "source_tibetan": "བཞི་པོ་རོ་རྣམས་ཅི་ཡིས་སྙོམས། །",
      "reading_tibetan": "བཞི་པོ་རོ་རྣམས་ཅི་ཡིས་སྙོམས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
