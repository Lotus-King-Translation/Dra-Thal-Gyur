      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00261",
      "source_tibetan": "འདི་དག་བདག་གིས་སྔར་མ་འཚལ། །",
      "reading_tibetan": "འདི་དག་བདག་གིས་སྔར་མ་འཚལ། །",
