      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00258",
      "source_tibetan": "འཕགས་པའི་རྫུ་འཕྲུལ་ཅི་ཡིས་འགྲུབ།།",
      "reading_tibetan": "འཕགས་པའི་རྫུ་འཕྲུལ་ཅི་ཡིས་འགྲུབ།།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00259",
      "source_tibetan": "གཏེར་ལ་ལོངས་སྤྱོད་ཅི་ལྟར་བགྱི། །",
      "reading_tibetan": "གཏེར་ལ་ལོངས་སྤྱོད་ཅི་ལྟར་བགྱི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00260",
      "source_tibetan": "གཞི་ལྔ་དབང་དུ་གང་གིས་འདུས། །",
