      "source_tibetan": "མངོན་སུམ་གནད་ལ་ཅི་ལྟར་བསྒྲེ། །",
      "reading_tibetan": "མངོན་སུམ་གནད་ལ་ཅི་ལྟར་བསྒྲེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00244",
      "source_tibetan": "འཁོར་འདས་རུ་ཤན་གང་གིས་ཕྱེད། །",
      "reading_tibetan": "འཁོར་འདས་རུ་ཤན་གང་གིས་ཕྱེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00245",
      "source_tibetan": "རླུང་འཛིན་སྤྱོད་པ་རྣམ་པ་དུ། །",
      "reading_tibetan": "རླུང་འཛིན་སྤྱོད་པ་རྣམ་པ་དུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00246",
      "source_tibetan": "སེམས་འཛིན་བསླབ་རིམ་གང་ཙམ་ཞིག །",
      "reading_tibetan": "སེམས་འཛིན་བསླབ་རིམ་གང་ཙམ་ཞིག །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00247",
      "source_tibetan": "ཕྱི་ནང་གསང་བའི་འཆི་རྟགས་ཅི། །",
      "reading_tibetan": "ཕྱི་ནང་གསང་བའི་འཆི་རྟགས་ཅི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00248",
      "source_tibetan": "བལྟ་བ་མཐའ་ལ་གང་གིས་བསྐྱལ། །",
      "reading_tibetan": "བལྟ་བ་མཐའ་ལ་གང་གིས་བསྐྱལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
