      "reading_tibetan": "མཆོད་རྟེན་དབྱིབས་འདྲ་བང་རིམ་མཛེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00542",
      "source_tibetan": "བཀོད་པ་ལྔ་ཡིས་ཡོངས་སུ་སྨྲས། །",
      "reading_tibetan": "བཀོད་པ་ལྔ་ཡིས་ཡོངས་སུ་སྤྲས། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00543",
      "source_tibetan": "སྒྲ་དབྱངས་སྣ་ཚོགས་འབྱུང་བའི་གཞི། །",
      "reading_tibetan": "སྒྲ་དབྱངས་སྣ་ཚོགས་འབྱུང་བའི་གཞི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00544",
      "source_tibetan": "སྟོན་པའི་བསྟན་པ་དུས་འབྱུང་ངེས། །",
      "reading_tibetan": "སྟོན་པའི་བསྟན་པ་དུས་འབྱུང་ངེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00545",
      "source_tibetan": "དེ་སྟེང་ཉི་ཤུ་རྩ་གཅིག་ན། །",
      "reading_tibetan": "དེ་སྟེང་ཉི་ཤུ་རྩ་གཅིག་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00546",
      "source_tibetan": "རབ་ཏུ་ཐལ་བས་ཁྱབ་ཅེས་བྱ། །",
      "reading_tibetan": "རབ་ཏུ་ཐལ་བས་ཁྱབ་ཅེས་བྱ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00547",
      "source_tibetan": "དམིགས་པ་དག་པའི་རང་བཞིན་དུ། །",
      "reading_tibetan": "དམིགས་པ་དག་པའི་རང་བཞིན་དུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00548",
      "source_tibetan": "ཕྱི་དང་ནང་མེད་ཟང་ཐལ་སྣང་། །",
      "reading_tibetan": "ཕྱི་དང་ནང་མེད་ཟང་ཐལ་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00549",
      "source_tibetan": "སྟོན་པའི་བསྟན་པ་འབྱུང་བར་སྟོན། །",
      "reading_tibetan": "སྟོན་པའི་བསྟན་པ་འབྱུང་བར་སྟོན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00550",
      "source_tibetan": "བྱེད་པའི་རྒྱུ་རྐྱེན་ཁྱབ་འཇུག་གོ། །",
      "reading_tibetan": "བྱེད་པའི་རྒྱུ་རྐྱེན་ཁྱབ་འཇུག་གོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00551",
      "source_tibetan": "འདི་ནས་འཇིག་རྟེན་ལྷོ་ཤར་གཡོན། །",
      "reading_tibetan": "འདི་ནས་འཇིག་རྟེན་ལྷོ་ཤར་གཡོན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00552",
      "source_tibetan": "འཇིག་རྟེན་ཁམས་ནི་དྲུག་འདས་ན། །",
      "reading_tibetan": "འཇིག་རྟེན་ཁམས་ནི་དྲུག་འདས་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00553",
      "source_tibetan": "ཐལ་བའི་སྒྲ་ཞེས་བྱ་བ་ཡི། །",
      "reading_tibetan": "ཐལ་བའི་སྒྲ་ཞེས་བྱ་བ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00554",
      "source_tibetan": "སྐྱོད་བྱེད་འཕན་གྱིས་རབ་ཏུ་བཀླུབས། །",
      "reading_tibetan": "སྐྱོད་བྱེད་འཕན་གྱིས་རབ་ཏུ་བཀླུབས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00555",
      "source_tibetan": "རྒྱལ་མཚན་གདུགས་ལ་སོགས་པ་བསྒྲེང༌། །",
      "reading_tibetan": "རྒྱལ་མཚན་གདུགས་ལ་སོགས་པ་བསྒྲེང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
