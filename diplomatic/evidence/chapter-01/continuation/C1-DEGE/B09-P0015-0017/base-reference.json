      "reading_tibetan": "འཕོང་དང་སྒྱུ་རྩལ་རྣམས་ཀྱིས་བརྒྱན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00854",
      "source_tibetan": "འདིས་ནི་ཆོས་བྱེད་བསྣུབས་ནས་ནི། །",
      "reading_tibetan": "འདིས་ནི་ཆོས་བྱེད་བསྣུབས་ནས་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00855",
      "source_tibetan": "ལོ་ནི་དྲུག་ཅུར་བསྟན་པ་ཉིད། །",
      "reading_tibetan": "ལོ་ནི་དྲུག་ཅུར་བསྟན་པ་ཉིད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00856",
      "source_tibetan": "འདིར་ནི་ནུབ་ནས་གཞན་དུ་འགྱུར། །",
      "reading_tibetan": "འདིར་ནི་ནུབ་ནས་གཞན་དུ་འགྱུར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00857",
      "source_tibetan": "དེ་འདས་རང་སངས་རྒྱས་ཀྱི་གཟུགས། །",
      "reading_tibetan": "དེ་འདས་རང་སངས་རྒྱས་ཀྱི་གཟུགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00858",
      "source_tibetan": "རྡོ་རྗེ་གདན་ནས་ནུབ་ཏུ་འབྱུང༌། །",
      "reading_tibetan": "རྡོ་རྗེ་གདན་ནས་ནུབ་ཏུ་འབྱུང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00859",
      "source_tibetan": "དེས་ནི་བསྟན་པ་དམ་པ་ཉིད། །",
      "reading_tibetan": "དེས་ནི་བསྟན་པ་དམ་པ་ཉིད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00860",
      "source_tibetan": "ལོ་ནི་བརྒྱ་དང་ཉི་ཤུར་གནས། །",
      "reading_tibetan": "ལོ་ནི་བརྒྱ་དང་ཉི་ཤུར་གནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00861",
      "source_tibetan": "དེ་འདས་འོག་ཏུ་འཛམ་གླིང་དབུས། །",
      "reading_tibetan": "དེ་འདས་འོག་ཏུ་འཛམ་གླིང་དབུས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00862",
      "source_tibetan": "གསེར་གྱི་གྲོང་ཁྱེར་ཞེས་བྱ་བར། །",
      "reading_tibetan": "གསེར་གྱི་གྲོང་ཁྱེར་ཞེས་བྱ་བར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00863",
      "source_tibetan": "གནས་རྟེན་ལུས་ལ་ལྕེ་རྩེ་གཉིས། །",
      "reading_tibetan": "གནས་རྟེན་ལུས་ལ་ལྕེ་རྩེ་གཉིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00864",
      "source_tibetan": "བོངས་ཆུང་ཡན་ལག་ཐུང་བ་ཞིག །",
      "reading_tibetan": "བོངས་ཆུང་ཡན་ལག་ཐུང་བ་ཞིག །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00865",
      "source_tibetan": "སྡེ་པ་རྩོད་ཅིང་མཚོན་ཆ་འཛིན། །",
      "reading_tibetan": "སྡེ་པ་རྩོད་ཅིང་མཚོན་ཆ་འཛིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00866",
      "source_tibetan": "འདི་འབྱུང་བས་ནི་མུན་པར་ཡང༌། །",
      "reading_tibetan": "འདི་འབྱུང་བས་ནི་མུན་པར་ཡང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00867",
      "source_tibetan": "ལོ་ནི་དྲུག་ཅུའི་བར་ལ་འགྱུར། །",
      "reading_tibetan": "ལོ་ནི་དྲུག་ཅུའི་བར་ལ་འགྱུར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00868",
      "source_tibetan": "དེ་འདས་འོག་ཏུ་འཛམ་གླིང་ཤར། །",
      "reading_tibetan": "དེ་འདས་འོག་ཏུ་འཛམ་གླིང་ཤར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00869",
      "source_tibetan": "ཆུ་བོ་དག་ནི་ལོ་ཀི་ཏ། །",
      "reading_tibetan": "ཆུ་བོ་དག་ནི་ལོ་ཀི་ཏ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00870",
      "source_tibetan": "གཡས་ཀྱི་ཕྱོགས་ཀྱི་འགྲམ་དག་ཏུ། །",
      "reading_tibetan": "གཡས་ཀྱི་ཕྱོགས་ཀྱི་འགྲམ་དག་ཏུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
