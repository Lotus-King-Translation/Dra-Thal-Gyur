    },
    {
      "id": "U00002",
      "source_tibetan": "རཏྞཱཀཱརཤབྡམཧཱཔྲསཾགཏནྟྲནཱམབིཧརཏིསྨ།།",
      "reading_tibetan": "རཏྞཱཀཱརཤབྡམཧཱཔྲསཾགཏནྟྲནཱམབིཧརཏིསྨ།།",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00003",
      "source_tibetan": "༄༅།",
      "reading_tibetan": "༄༅།",
      "status": "unverified_transcription_scaffold"
    },
    {
      "id": "U00004",
      "source_tibetan": " རིན་པོ་ཆེ་འབྱུང་བར་བྱེད་པ་སྒྲ་ཐལ་འགྱུར་ཆེན་པོའི་རྒྱུད་ཅེས་བྱ་བ་བཞུགས།",
      "reading_tibetan": " རིན་པོ་ཆེ་འབྱུང་བར་བྱེད་པ་སྒྲ་ཐལ་འགྱུར་ཆེན་པོའི་རྒྱུད་ཅེས་བྱ་བ་བཞུགས།",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00005",
      "source_tibetan": "གཾགརྦམཏགཱ རྒྱ་གར་སྐད་དུ།",
      "reading_tibetan": "གཾགརྦམཏགཱ རྒྱ་གར་སྐད་དུ།",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00006",
      "source_tibetan": " རཏྣ་ཀ་ར་ཤབྡ་མ་ཧཱ་པྲ་སཾ་ག་ཏནྟྲ་ནཱ་མ།",
      "reading_tibetan": " རཏྣ་ཀ་ར་ཤབྡ་མ་ཧཱ་པྲ་སཾ་ག་ཏནྟྲ་ནཱ་མ།",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00007",
      "source_tibetan": " བོད་སྐད་དུ།",
      "reading_tibetan": " བོད་སྐད་དུ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00008",
      "source_tibetan": " རིན་པོ་ཆེ་འབྱུང་བར་བྱེད་པ་སྒྲ་ཐལ་འགྱུར་ཆེན་པོའི་རྒྱུད་ཅེས་བྱ་བ།",
      "reading_tibetan": " རིན་པོ་ཆེ་འབྱུང་བར་བྱེད་པ་སྒྲ་ཐལ་འགྱུར་ཆེན་པོའི་རྒྱུད་ཅེས་བྱ་བ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00009",
      "source_tibetan": " བཅོམ་ལྡན་འདས་རང་བྱུང་ཆེན་པོ་མཆོག་གི་སྟོན་པ།",
      "reading_tibetan": " བཅོམ་ལྡན་འདས་རང་བྱུང་ཆེན་པོ་མཆོག་གི་སྟོན་པ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00010",
      "source_tibetan": " དཔལ་ཀུན་ཏུ་བཟང་པོ་ལ་ཕྱག་འཚལ་ལོ། །",
      "reading_tibetan": " དཔལ་ཀུན་ཏུ་བཟང་པོ་ལ་ཕྱག་འཚལ་ལོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00011",
      "source_tibetan": "ཐུན་མོང་མ་ཡིན་པའི་གླེང་གཞི་བཀོད་པ།",
      "reading_tibetan": "ཐུན་མོང་མ་ཡིན་པའི་གླེང་གཞི་བཀོད་པ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00012",
      "source_tibetan": "འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་གཅིག་ན། །",
      "reading_tibetan": "འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་གཅིག་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00013",
      "source_tibetan": "འཁོར་དང་འདས་པའི་ཐོག་མར་ནི། །",
      "reading_tibetan": "འཁོར་དང་འདས་པའི་ཐོག་མར་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00014",
      "source_tibetan": "རང་བྱུང་བྱས་པ་མེད་པ་ལས། །",
      "reading_tibetan": "རང་བྱུང་བྱས་པ་མེད་པ་ལས། །",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00015",
      "source_tibetan": "འབྱུང་བ་འདུས་པའི་ཕུང་པོར་ཤར། །",
      "reading_tibetan": "འབྱུང་བ་འདུས་པའི་ཕུང་པོར་ཤར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00016",
      "source_tibetan": " ས་ཆུ་མེ་རླུང་འབྱུང་བ་བཞི། །",
      "reading_tibetan": " ས་ཆུ་མེ་རླུང་འབྱུང་བ་བཞི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00017",
      "source_tibetan": "དབུས་སུ་རླུང་སེམས་རྒྱུ་དང་རྐྱེན། །",
      "reading_tibetan": "དབུས་སུ་རླུང་སེམས་རྒྱུ་དང་རྐྱེན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00018",
      "source_tibetan": "འདུས་ཤིང་བསྐྱེད་པའི་གཞལ་མེད་ཁང་། །",
      "reading_tibetan": "འདུས་ཤིང་བསྐྱེད་པའི་གཞལ་མེད་ཁང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00019",
      "source_tibetan": "རང་བྱུང་རིག་པས་བཅོས་པ་མེད། །",
      "reading_tibetan": "རང་བྱུང་རིག་པས་བཅོས་པ་མེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00020",
      "source_tibetan": "འཁྲུལ་པ་ཡོངས་སུ་དག་པ་ལ། །",
      "reading_tibetan": "འཁྲུལ་པ་ཡོངས་སུ་དག་པ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00021",
      "source_tibetan": "བདེ་ཆེན་འདུས་པའི་ཐབས་ཀྱི་འཁོར། །",
      "reading_tibetan": "བདེ་ཆེན་འདུས་པའི་ཐབས་ཀྱི་འཁོར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00022",
      "source_tibetan": "སྐུ་དང་ཡེ་ཤེས་ཤེས་རབ་རླུང་། །",
      "reading_tibetan": "སྐུ་དང་ཡེ་ཤེས་ཤེས་རབ་རླུང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00023",
      "source_tibetan": "མི་ཕྱེད་སྣ་ཚོགས་དམིགས་མེད་པས། །",
      "reading_tibetan": "མི་ཕྱེད་སྣ་ཚོགས་དམིགས་མེད་པས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00024",
      "source_tibetan": "རྩ་རླུང་ཐབས་ཀྱི་བདེ་ཆེན་ཆོས། །",
      "reading_tibetan": "རྩ་རླུང་ཐབས་ཀྱི་བདེ་ཆེན་ཆོས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00025",
      "source_tibetan": "སོ་སོའི་ཉམས་དང་མཐུན་པར་བཤད། །",
      "reading_tibetan": "སོ་སོའི་ཉམས་དང་མཐུན་པར་བཤད། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
  ],
