      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02620",
      "source_tibetan": "དེ་དག་གི་ཞབས་སྡུད་པའོ། །",
      "reading_tibetan": "",
      "status": "scan_intervention"
    },
    {
      "id": "U02621",
      "source_tibetan": "སྟོན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས། །",
      "reading_tibetan": "སྟོན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02622",
      "source_tibetan": "ཡོན་ཏན་ཐམས་ཅད་རང་རྫོགས་པས། །",
      "reading_tibetan": "ཡོན་ཏན་ཐམས་ཅད་རང་རྫོགས་པས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02623",
      "source_tibetan": "བརྗོད་ཅིང་གསུངས་པ་མ་ཡིན་པར། །",
      "reading_tibetan": "བརྗོད་ཅིང་གསུངས་པ་མ་ཡིན་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02624",
      "source_tibetan": "རང་བྱུང་ཡེ་ཤེས་རོལ་པ་ལས། །",
      "reading_tibetan": "རང་བྱུང་ཡེ་ཤེས་རོལ་པ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02625",
      "source_tibetan": "སྒྲ་ཚིག་མིང་གི་ཆོ་འཕྲུལ་དུ། །",
      "reading_tibetan": "སྒྲ་ཚིག་མིང་གི་ཆོ་འཕྲུལ་དུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02626",
      "source_tibetan": "སྐལ་བ་བཟང་པོ་རྣམས་ལ་སྣང་། །",
      "reading_tibetan": "སྐལ་བ་བཟང་པོ་རྣམས་ལ་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02627",
      "source_tibetan": "དེ་ལྟར་རྫོགས་ཆེན་གསང་བའི་ཚིག །",
      "reading_tibetan": "དེ་ལྟར་རྫོགས་ཆེན་གསང་བའི་ཚིག །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02628",
      "source_tibetan": "ལྷ་དབང་གིས་ནི་ངེས་ཐོས་ནས། །",
      "reading_tibetan": "ལྷ་དབང་གིས་ནི་ངེས་ཐོས་ནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02629",
      "source_tibetan": "ལུས་གུས་ཐལ་མོ་ལེགས་སྦྱར་ཏེ། །",
      "reading_tibetan": "ལུས་གུས་ཐལ་མོ་ལེགས་སྦྱར་ཏེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02630",
      "source_tibetan": "སྟོན་པ་ཉིད་ལ་རྗེས་ཡི་རང་། །",
      "reading_tibetan": "སྟོན་པ་ཉིད་ལ་རྗེས་ཡི་རང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02631",
      "source_tibetan": "ཐམས་ཅད་རྫོགས་པ་ཆེན་པོ་ལས། །",
      "reading_tibetan": "ཐམས་ཅད་རྫོགས་པ་ཆེན་པོ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02632",
      "source_tibetan": "རང་བཞིན་སྤྲོས་པ་མེད་པར་གྱུར། །",
      "reading_tibetan": "རང་བཞིན་སྤྲོས་པ་མེད་པར་གྱུར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02633",
      "source_tibetan": "ཆོས་ཉིད་དབྱིངས་ལས་དབྱེར་མེད་པའོ། །",
      "reading_tibetan": "ཆོས་ཉིད་དབྱིངས་ལས་དབྱེར་མེད་པའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02634",
      "source_tibetan": "ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས།",
      "reading_tibetan": "ཞེས་སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་ཆོས་རྣམས་ཀུན་གྱི་རྩ་བ་ལས།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U02635",
      "source_tibetan": "སྣ་ཚོགས་བཀོད་པ་རང་བྱུང་མན་ངག་གི་རྩ་་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་དང་པོའོ།།",
      "reading_tibetan": "སྣ་ཚོགས་བཀོད་པ་རང་བྱུང་མན་ངག་གི་རྩ་་བ་ངེས་པར་འབྱུང་བའི་ལེའུ་སྟེ་དང་པོའོ།།",
