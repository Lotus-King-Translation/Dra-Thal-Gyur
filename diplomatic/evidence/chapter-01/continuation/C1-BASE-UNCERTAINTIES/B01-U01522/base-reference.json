      "reading_tibetan": "སྔོན་དུ་སྦྱང་བའི་རིམ་པ་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01521",
      "source_tibetan": "ལུས་ཀྱི་སྔོན་དུ་འགྲོ་བ་ལས། །",
      "reading_tibetan": "ལུས་ཀྱི་སྔོན་དུ་འགྲོ་བ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01522",
      "source_tibetan": "སོ་སོའི་བྱེད་པའི་རྒྱུ་འགགས་པ། །",
      "reading_tibetan": "སོ་སོའི་བྱེད་པའི་རྒྱུ་འགགས་པ། །",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U01523",
      "source_tibetan": "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་དུ་བཅས་ཏེ། །",
      "reading_tibetan": "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་དུ་བཅས་ཏེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01524",
      "source_tibetan": "ལུས་སྦྱང་སེམས་ལ་ཕན་པའོ། །",
      "reading_tibetan": "ལུས་སྦྱང་སེམས་ལ་ཕན་པའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01525",
      "source_tibetan": "ངག་ནི་ཧཱུཾ་ཞེས་གནས་པ་ལས། །",
      "reading_tibetan": "ངག་ནི་ཧཱུཾ་ཞེས་གནས་པ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01526",
      "source_tibetan": "རྒྱས་གདབ་པ་དང་རྩལ་སྦྱང་དང་། །",
      "reading_tibetan": "རྒྱས་གདབ་པ་དང་རྩལ་སྦྱང་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01527",
      "source_tibetan": "གཉན་བཙལ་ལམ་དུ་ཞུགས་པ་ཡིས། །",
      "reading_tibetan": "གཉན་བཙལ་ལམ་དུ་ཞུགས་པ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01528",
      "source_tibetan": "དེ་ལྟར་ངག་སྦྱང་སེམས་ལ་ཕན། །",
      "reading_tibetan": "དེ་ལྟར་ངག་སྦྱང་སེམས་ལ་ཕན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01529",
      "source_tibetan": "སེམས་ནི་ཐོག་མ་བྱུང་བ་དང་། །",
      "reading_tibetan": "སེམས་ནི་ཐོག་མ་བྱུང་བ་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01530",
      "source_tibetan": "བར་དུ་གནས་པ་ཐ་མར་འགྲོ། །",
      "reading_tibetan": "བར་དུ་གནས་པ་ཐ་མར་འགྲོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01531",
      "source_tibetan": "དེ་ལྟར་གསུམ་ལ་བརྟགས་དཔྱད་ན། །",
      "reading_tibetan": "དེ་ལྟར་གསུམ་ལ་བརྟགས་དཔྱད་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01532",
      "source_tibetan": "སེམས་སྦྱང་སེམས་ཀྱི་གནས་ལུགས་ཤེས། །",
      "reading_tibetan": "སེམས་སྦྱང་སེམས་ཀྱི་གནས་ལུགས་ཤེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01533",
      "source_tibetan": "དངོས་གཞི་རང་གི་རྒྱུད་བརྟེན་ནི། །",
      "reading_tibetan": "དངོས་གཞི་རང་གི་རྒྱུད་བརྟེན་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01534",
      "source_tibetan": "ལུས་ཀྱི་གནད་དང་ངག་དང་ཡང་།",
      "reading_tibetan": "ལུས་ཀྱི་གནད་དང་ངག་དང་ཡང་། །",
      "status": "scan_intervention"
    },
    {
      "id": "U01535",
      "source_tibetan": "སེམས་ཀྱི་གནད་ལ་བརྟེན་པ་ཡིས། །",
      "reading_tibetan": "སེམས་ཀྱི་གནད་ལ་བརྟེན་པ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01536",
      "source_tibetan": "རླུང་ནི་ཅི་ནས་དལ་བྱ་སྟེ། །",
      "reading_tibetan": "རླུང་ནི་ཅི་ནས་དལ་བྱ་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01537",
      "source_tibetan": "རབ་ཏུ་འཕང་བ་ལས་བྱུང་བ། །",
      "reading_tibetan": "རབ་ཏུ་འཕང་བ་ལས་བྱུང་བ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01538",
      "source_tibetan": "ལུས་དང་སེམས་ཀྱི་འབྲེལ་ཆད་དེ། །",
      "reading_tibetan": "ལུས་དང་སེམས་ཀྱི་འབྲེལ་ཆད་དེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01539",
      "source_tibetan": "ཁམས་གསུམ་དུ་ཡང་ལྡོག་པ་མིན། །",
      "reading_tibetan": "ཁམས་གསུམ་དུ་ཡང་ལྡོག་པ་མིན།",
      "status": "scan_intervention"
    },
    {
      "id": "U01540",
      "source_tibetan": "དྲིས་ལན་སོ་གཉིས་པ།",
      "reading_tibetan": "དྲིས་ལན་སོ་གཉིས་པ། །",
      "status": "scan_intervention"
    },
    {
      "id": "U01541",
      "source_tibetan": "རླུང་གི་དགོས་པ་རྣམ་པ་གཉིས། །",
      "reading_tibetan": "རླུང་གི་དགོས་པ་རྣམ་པ་གཉིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01542",
      "source_tibetan": "འཇིག་རྟེན་ལུས་རྫོགས་བསྐྱེད་པ་དང་། །",
      "reading_tibetan": "འཇིག་རྟེན་ལུས་རྫོགས་བསྐྱེད་པ་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U01543",
      "source_tibetan": "བརྟེན་ཅིང་གནས་པའི་ཚེ་རྣམས་དང༌། །",
      "reading_tibetan": "བརྟེན་ཅིང་གནས་པའི་ཚེ་རྣམས་དང༌། །",
