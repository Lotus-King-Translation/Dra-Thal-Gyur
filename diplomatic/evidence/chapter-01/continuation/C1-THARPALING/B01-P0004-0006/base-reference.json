      "source_tibetan": "བསྒོམ་པའི་སྲོག་ཤིང་གང་དང་གང་། །",
      "reading_tibetan": "བསྒོམ་པའི་སྲོག་ཤིང་གང་དང་གང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00250",
      "source_tibetan": "སྤྱོད་པའི་སྦྱོར་བ་ཇི་ལྟ་བུ། །",
      "reading_tibetan": "སྤྱོད་པའི་སྦྱོར་བ་ཇི་ལྟ་བུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00251",
      "source_tibetan": "འབྲས་བུའི་ཐོབ་ས་གང་ཙམ་ཞིག །",
      "reading_tibetan": "འབྲས་བུའི་ཐོབ་ས་གང་ཙམ་ཞིག །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00252",
      "source_tibetan": "འཁོར་བའི་ཆུ་རྒྱུན་ཅི་ཡིས་གཅོད།",
      "reading_tibetan": "འཁོར་བའི་ཆུ་རྒྱུན་ཅི་ཡིས་གཅོད། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00253",
      "source_tibetan": "བཅུད་ཀྱིས་ལེན་པ་ཇི་ལྟ་བུ། །",
      "reading_tibetan": "བཅུད་ཀྱིས་ལེན་པ་ཇི་ལྟ་བུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00254",
      "source_tibetan": "གོས་ནི་གང་གིས་འགྲུབ་པ་ལགས། །",
      "reading_tibetan": "གོས་ནི་གང་གིས་འགྲུབ་པ་ལགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00255",
      "source_tibetan": "འབྱུང་བའི་རྒྱུན་ནི་ཅི་ལྟར་གཅད། །",
      "reading_tibetan": "འབྱུང་བའི་རྒྱུན་ནི་ཅི་ལྟར་གཅད། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
