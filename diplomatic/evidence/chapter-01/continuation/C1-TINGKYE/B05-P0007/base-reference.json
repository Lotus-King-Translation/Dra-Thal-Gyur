      "reading_tibetan": "དེ་ཕྱིར་བདག་གིས་ཅི་ཞུས་པ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00271",
      "source_tibetan": "རིམ་པ་གསལ་བར་ཕྱེས་ལ་གསུང་། །",
      "reading_tibetan": "རིམ་པ་གསལ་བར་ཕྱེས་ལ་གསུང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00272",
      "source_tibetan": "དེ་ནས་རྒྱུད་ཀྱི་ཆེ་བ་རྣམ་པར་བཀོད་པའི་བཀོད་པ་ཁྱབ་བདག་སེམས་དཔའ་ནི། །",
      "reading_tibetan": "དེ་ནས་ཁྱབ་བདག་སེམས་དཔའ་ནི། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00273",
      "source_tibetan": "སྒྲ་ཚིག་མིང་དུ་མ་བསྒྲགས་ཀྱང༌། །",
      "reading_tibetan": "སྒྲ་ཚིག་མིང་དུ་མ་བསྒྲགས་ཀྱང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00274",
      "source_tibetan": "རང་བཞིན་བཅོས་མེད་ནམ་མཁའ་ལ། །",
      "reading_tibetan": "རང་བཞིན་བཅོས་མེད་ནམ་མཁའ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00275",
      "source_tibetan": "བྲིས་ཞིང་བཀོད་པ་མ་ཡིན་པར། །",
      "reading_tibetan": "བྲིས་ཞིང་བཀོད་པ་མ་ཡིན་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00276",
      "source_tibetan": "ཡན་ལག་དྲུག་ཅུའི་དབྱངས་ལྡན་ཏེ། །",
      "reading_tibetan": "ཡན་ལག་དྲུག་ཅུའི་དབྱངས་ལྡན་ཏེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00277",
      "source_tibetan": "མ་བྲིས་རི་མོའི་ཚུལ་ཙམ་དུ། །",
      "reading_tibetan": "མ་བྲིས་རི་མོའི་ཚུལ་ཙམ་དུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00278",
      "source_tibetan": "མདངས་དང་ལྡན་པའི་དབང་པོ་ལ། །",
      "reading_tibetan": "མདངས་དང་ལྡན་པའི་དབང་པོ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00279",
      "source_tibetan": " ངེས་པར་སྣང་སྟེ་མངོན་སུམ་པའོ། །",
      "reading_tibetan": " ངེས་པར་སྣང་སྟེ་མངོན་སུམ་པའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00280",
      "source_tibetan": "ཚངས་པ་ཆེན་པོའི་སྒྲ་ལ་ཡང་། །",
      "reading_tibetan": "ཚངས་པ་ཆེན་པོའི་སྒྲ་ལ་ཡང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00281",
      "source_tibetan": "ཨིནྡྲ་ལྷ་ཡི་དབང་ཕྱུག་ཉོན། །",
      "reading_tibetan": "ཨིནྡྲ་ལྷ་ཡི་དབང་ཕྱུག་ཉོན། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
