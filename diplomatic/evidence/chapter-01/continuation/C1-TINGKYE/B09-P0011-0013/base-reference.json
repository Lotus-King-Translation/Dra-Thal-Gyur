      "source_tibetan": "ཁྱད་པར་སྤྲུལ་པའི་སྐུ་ལས་འཕྲོས། །",
      "reading_tibetan": "ཁྱད་པར་སྤྲུལ་པའི་སྐུ་ལས་འཕྲོས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00462",
      "source_tibetan": "འཕྲོས་པ་ཡི་ནི་ཟེར་ཙམ་གྱིས། །",
      "reading_tibetan": "འཕྲོས་པ་ཡི་ནི་ཟེར་ཙམ་གྱིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00463",
      "source_tibetan": "རྣལ་འབྱོར་རྟོག་པའི་ཆུ་རྒྱུན་འགགས། །",
      "reading_tibetan": "རྣལ་འབྱོར་རྟོག་པའི་ཆུ་རྒྱུན་འགགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00464",
      "source_tibetan": "གནས་དང་འབྱེད་དང་གནས་བཅུད་ཡུལ། །",
      "reading_tibetan": "གནས་དང་འབྱེད་དང་གནས་བཅུད་ཡུལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00465",
      "source_tibetan": "ཐོབ་ཅིང་མཐོང་རྟོགས་ངེས་འཇུག་པའོ། །",
      "reading_tibetan": "ཐོབ་ཅིང་མཐོང་རྟོགས་ངེས་འཇུག་པའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00466",
      "source_tibetan": "དེ་ལྟར་སྒྲ་ཡི་དགོས་པ་ནི། །",
      "reading_tibetan": "དེ་ལྟར་སྒྲ་ཡི་དགོས་པ་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00467",
      "source_tibetan": "རྣམ་པ་གཉིས་སུ་ཤེས་བྱ་སྟེ། །",
      "reading_tibetan": "རྣམ་པ་གཉིས་སུ་ཤེས་བྱ་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00468",
      "source_tibetan": "མཆོག་དང་ཐུན་མོང་པ་དག་གི། །",
      "reading_tibetan": "མཆོག་དང་ཐུན་མོང་པ་དག་གི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00469",
      "source_tibetan": "ལས་ཅན་སོ་སོའི་ངེས་འབྱེད་འཕྲུལ། །",
      "reading_tibetan": "ལས་ཅན་སོ་སོའི་ངེས་འབྱེད་འཕྲུལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00470",
      "source_tibetan": "མཆོག་ལ་སྐུ་ལྔ་མངོན་པར་འགྲུབ། །",
      "reading_tibetan": "མཆོག་ལ་སྐུ་ལྔ་མངོན་པར་འགྲུབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00471",
      "source_tibetan": "དེ་ལྟར་གྲུབ་པའི་རྟགས་བཅུ་ཡིས། །",
      "reading_tibetan": "དེ་ལྟར་གྲུབ་པའི་རྟགས་བཅུ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00472",
      "source_tibetan": "རྡོ་རྗེ་འཆང་གི་ལུས་དང་མཉམ། །",
      "reading_tibetan": "རྡོ་རྗེ་འཆང་གི་ལུས་དང་མཉམ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00473",
      "source_tibetan": "འདི་ལ་ཡོན་ཏན་བརྗོད་མི་ལངས། །",
      "reading_tibetan": "འདི་ལ་ཡོན་ཏན་བརྗོད་མི་ལངས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00474",
      "source_tibetan": "ཆོས་དང་ཆོས་ཀྱི་དབྱིངས་ཉིད་དང་། །",
      "reading_tibetan": "ཆོས་དང་ཆོས་ཀྱི་དབྱིངས་ཉིད་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00475",
      "source_tibetan": "གཞི་དང་ལམ་དང་འབྲས་བུ་ལ། །",
      "reading_tibetan": "གཞི་དང་ལམ་དང་འབྲས་བུ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00476",
      "source_tibetan": "བདེ་བར་རོལ་པ་ཉིད་ཡིན་ནོ། །",
      "reading_tibetan": "བདེ་བར་རོལ་པ་ཉིད་ཡིན་ནོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00477",
      "source_tibetan": "ཐུན་མོང་གྱུར་པའི་དགོས་པ་ནི། །",
      "reading_tibetan": "ཐུན་མོང་གྱུར་པའི་དགོས་པ་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00478",
      "source_tibetan": "སྒྲ་ཚད་རིག་པའི་བསྟན་ཆོས་དང༌། །",
      "reading_tibetan": "སྒྲ་ཚད་རིག་པའི་བསྟན་ཆོས་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00479",
      "source_tibetan": "བཟོ་དང་སྒྱུ་རྩལ་སྣ་ཚོགས་དང༌། །",
      "reading_tibetan": "བཟོ་དང་སྒྱུ་རྩལ་སྣ་ཚོགས་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00480",
      "source_tibetan": "འཕོངས་དང་མ་སྦྱངས་ལས་རྣམས་འགྲུབ། །",
      "reading_tibetan": "འཕོངས་དང་མ་སྦྱངས་ལས་རྣམས་འགྲུབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00481",
      "source_tibetan": "འབྱུང་བ་ལྔ་ལ་སྤྱོད་ནུས་དང༌། །",
      "reading_tibetan": "འབྱུང་བ་ལྔ་ལ་སྤྱོད་ནུས་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00482",
      "source_tibetan": "མཚོན་དང་དུག་ལས་རྒྱལ་བ་དང༌། །",
      "reading_tibetan": "མཚོན་དང་དུག་ལས་རྒྱལ་བ་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00483",
      "source_tibetan": "བེམ་དང་རིག་བཅས་སྒྲ་རྣམས་དང༌། །",
      "reading_tibetan": "བེམ་དང་རིག་བཅས་སྒྲ་རྣམས་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00484",
      "source_tibetan": "བརྡའ་དང་ཐ་སྙད་ལ་མཁས་འགྱུར། །",
      "reading_tibetan": "བརྡའ་དང་ཐ་སྙད་ལ་མཁས་འགྱུར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
