      "reading_tibetan": "འདི་འབྱུང་བས་ནི་འཕེལ་བའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00167",
      "source_tibetan": "ལུས་ཀུན་བརྫུས་པའི་ཐོག་མའི་ཚེ། །",
      "reading_tibetan": "ལུས་ཀུན་བརྫུས་པའི་ཐོག་མའི་ཚེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00168",
      "source_tibetan": "ཚེ་ལོ་དཔག་ཏུ་མེད་དུས་སུ། །",
      "reading_tibetan": "ཚེ་ལོ་དཔག་ཏུ་མེད་དུས་སུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00169",
      "source_tibetan": "བརྫུས་ནས་སྐྱེས་པའི་འགྲོ་བ་ལ། །",
      "reading_tibetan": "བརྫུས་ནས་སྐྱེས་པའི་འགྲོ་བ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00170",
      "source_tibetan": "མི་འབྱེད་རང་བཞིན་རྣམ་དག་པ། །",
      "reading_tibetan": "མི་འབྱེད་རང་བཞིན་རྣམ་དག་པ། །",
