      "source_tibetan": "དེས་ན་བསྟན་པའི་སྙིང་པོ་བསྟན། །",
      "reading_tibetan": "དེས་ན་བསྟན་པའི་སྙིང་པོ་བསྟན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00308",
      "source_tibetan": "ཀྱེ་ཀྱེ་དགའ་བར་བྱེད་པས་ཟུང་། །",
      "reading_tibetan": "ཀྱེ་ཀྱེ་དགའ་བར་བྱེད་པས་ཟུང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00309",
      "source_tibetan": "དྲིས་པའི་ཚིག་རྣམས་གསལ་ཕྱེ་བས། །",
      "reading_tibetan": "དྲིས་པའི་ཚིག་རྣམས་གསལ་ཕྱེ་བས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00310",
      "source_tibetan": "ཁྱབ་འཇུག་གིས་ནི་སྐད་དག་ལས། །",
      "reading_tibetan": "ཁྱབ་འཇུག་གིས་ནི་སྐད་དག་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00311",
      "source_tibetan": "ཡི་གེའི་རྣམ་སྤྲུལ་འདི་ལྟ་བུ། །",
      "reading_tibetan": "ཡི་གེའི་རྣམ་སྤྲུལ་འདི་ལྟ་བུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00312",
      "source_tibetan": "རང་བཞིན་བཅོས་མེད་ནམ་མཁའ་ལ། །",
      "reading_tibetan": "རང་བཞིན་བཅོས་མེད་ནམ་མཁའ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00313",
      "source_tibetan": "མ་བཀོད་ཚིག་རྣམས་རང་བྱུང་བར། །",
      "reading_tibetan": "མ་བཀོད་ཚིག་རྣམས་རང་བྱུང་བར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00314",
      "source_tibetan": "དྲིས་དང་ལན་གྱི་ཚུལ་དུ་སྣང་། །",
      "reading_tibetan": "དྲིས་དང་ལན་གྱི་ཚུལ་དུ་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00315",
      "source_tibetan": "ངང་གཞི་བབ་ཀྱིས་གྲུབ་པ་ཡི། །",
      "reading_tibetan": "ངང་གཞི་བབ་ཀྱིས་གྲུབ་པ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00316",
      "source_tibetan": "ཚིག་བྱུང་གཞི་ལ་འདི་ལྟར་སྣང་།",
      "reading_tibetan": "ཚིག་བྱུང་གཞི་ལ་འདི་ལྟར་སྣང་།",
