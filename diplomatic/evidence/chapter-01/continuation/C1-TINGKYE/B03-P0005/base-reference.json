      "reading_tibetan": "ཐམས་ཅད་ངོ་བོ་དབྱེར་མེད་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00172",
      "source_tibetan": "བརྗོད་ཅིང་སྒྲ་ཚིག་བདེ་རིག་སྟེ། །",
