      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00176",
      "source_tibetan": "དབྱེར་མི་ཕྱེད་པས་སྙོམས་ཞུགས་ཏེ། །",
      "reading_tibetan": "དབྱེར་མི་ཕྱེད་པས་སྙོམས་ཞུགས་ཏེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
