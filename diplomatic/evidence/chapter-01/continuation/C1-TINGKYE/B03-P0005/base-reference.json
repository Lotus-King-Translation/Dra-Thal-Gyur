      "id": "U00164",
      "source_tibetan": "འདི་ལ་ཡོན་ཏན་བསམ་འདས་སོ། །",
      "reading_tibetan": "འདི་ལ་ཡོན་ཏན་བསམ་འདས་སོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00165",
      "source_tibetan": "སྤྲུལ་པའི་བསྟན་པ་ཐོག་མར་ནི། །",
      "reading_tibetan": "སྤྲུལ་པའི་བསྟན་པ་ཐོག་མར་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00166",
      "source_tibetan": "འདི་འབྱུང་བས་ནི་འཕེལ་བའོ། །",
      "reading_tibetan": "འདི་འབྱུང་བས་ནི་འཕེལ་བའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00167",
      "source_tibetan": "ལུས་ཀུན་བརྫུས་པའི་ཐོག་མའི་ཚེ། །",
      "reading_tibetan": "ལུས་ཀུན་བརྫུས་པའི་ཐོག་མའི་ཚེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
