      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00344",
      "source_tibetan": "དྲིས་ལན་གཉིས་པ།",
      "reading_tibetan": "དྲིས་ལན་གཉིས་པ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00345",
      "source_tibetan": "ཡན་ལག་དོན་ནི་འདི་ལྟ་བུ།།",
      "reading_tibetan": "ཡན་ལག་དོན་ནི་འདི་ལྟ་བུ།།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00346",
      "source_tibetan": "སངས་རྒྱས་རྣམས་ཀྱི་མཁྱེན་པ་ཡི། །",
      "reading_tibetan": "སངས་རྒྱས་རྣམས་ཀྱི་མཁྱེན་པ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00347",
      "source_tibetan": "ཚིག་བརྗོད་གསལ་བའི་རིམ་པ་ནི། །",
      "reading_tibetan": "ཚིག་བརྗོད་གསལ་བའི་རིམ་པ་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00348",
      "source_tibetan": "མཚན་བསྟན་པ་དང་གཞུང་གིས་ཀྱང༌། །",
      "reading_tibetan": "མཚན་བསྟན་པ་དང་གཞུང་གིས་ཀྱང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00349",
      "source_tibetan": "རིམ་དང་ཅིག་ཆར་བློ་རྣམས་ཀྱི། །",
      "reading_tibetan": "རིམ་དང་ཅིག་ཆར་བློ་རྣམས་ཀྱི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00350",
      "source_tibetan": "རྟོགས་པར་བྱ་ཕྱིར་རྣམ་བཤད་པའོ། །",
      "reading_tibetan": "རྟོགས་པར་བྱ་ཕྱིར་རྣམ་བཤད་པའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00351",
      "source_tibetan": "གཞུང་ལ་རྣམ་པ་གཉིས་སུ་བསྟན། །",
      "reading_tibetan": "གཞུང་ལ་རྣམ་པ་གཉིས་སུ་བསྟན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00352",
      "source_tibetan": "ལུས་ཉིད་རྣམ་པར་གཞག་པ་དང༌། །",
      "reading_tibetan": "ལུས་ཉིད་རྣམ་པར་གཞག་པ་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00353",
      "source_tibetan": "ཡན་ལག་དོན་གྱིས་རྒྱས་པར་དབྱེ། །",
      "reading_tibetan": "ཡན་ལག་དོན་གྱིས་རྒྱས་པར་དབྱེ། །",
