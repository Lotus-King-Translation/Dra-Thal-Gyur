      "reading_tibetan": "ཐལ་བ་བརྡལ་ཞེས་བྱ་བ་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00524",
      "source_tibetan": "པདྨ་རྒྱས་པའི་དབྱིབས་འདྲ་བ། །",
      "reading_tibetan": "པདྨ་རྒྱས་པའི་དབྱིབས་འདྲ་བ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00525",
      "source_tibetan": "ཤིན་ཏུ་བརྡལ་བ་ཁོད་སྙོམས་པ། །",
      "reading_tibetan": "ཤིན་ཏུ་བརྡལ་བ་ཁོད་སྙོམས་པ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00526",
      "source_tibetan": "སྣ་ཚོགས་འོད་འབར་ཁ་དོག་ནི། །",
      "reading_tibetan": "སྣ་ཚོགས་འོད་འབར་ཁ་དོག་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00527",
      "source_tibetan": "དཀར་དམར་སྣང་བ་འཁྲུགས་པ་ལས། །",
      "reading_tibetan": "དཀར་དམར་སྣང་བ་འཁྲུགས་པ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00528",
      "source_tibetan": "རགས་པའི་གཟུགས་བརྙན་སྣང་བ་མིན། །",
      "reading_tibetan": "རགས་པའི་གཟུགས་བརྙན་སྣང་བ་མིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00529",
      "source_tibetan": "སྟོན་པའི་བསྟན་པ་འདུ་མཆེད་རྒྱས། །",
      "reading_tibetan": "སྟོན་པའི་བསྟན་པ་འདུ་མཆེད་རྒྱས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00530",
      "source_tibetan": "བསྐལ་པ་རྫོགས་པས་ཐལ་ཞེས་བྱའོ། །",
      "reading_tibetan": "བསྐལ་པ་རྫོགས་པས་ཐལ་ཞེས་བྱའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00531",
      "source_tibetan": "འདི་ནས་འཇིག་རྟེན་སྟེང་དུ་ཡང༌། །",
      "reading_tibetan": "འདི་ནས་འཇིག་རྟེན་སྟེང་དུ་ཡང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00532",
      "source_tibetan": "བཅུ་དགུ་འདས་པའི་ཡང་སྟེང་ན། །",
      "reading_tibetan": "བཅུ་དགུ་འདས་པའི་ཡང་སྟེང་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00533",
      "source_tibetan": "ཐལ་བའི་བེ་ཅོན་ཞེས་བྱ་བ། །",
      "reading_tibetan": "ཐལ་བའི་བེ་ཅོན་ཞེས་བྱ་བ། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
  ],
