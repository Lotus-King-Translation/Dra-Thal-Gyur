      "reading_tibetan": "དེ་ཡི་འཁོར་དང་ལོངས་སྤྱོད་རྫོགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00589",
      "source_tibetan": "འདི་ནས་འཇིག་རྟེན་དྲུག་པ་ན། །",
      "reading_tibetan": "འདི་ནས་འཇིག་རྟེན་དྲུག་པ་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00590",
      "source_tibetan": "སྐར་མའི་ཐལ་བ་ཞེས་བྱ་བ། །",
      "reading_tibetan": "སྐར་མའི་ཐལ་བ་ཞེས་བྱ་བ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00591",
      "source_tibetan": "འཁོར་ལོ་བརྩེགས་པའི་རྣམ་པ་ནི། །",
      "reading_tibetan": "འཁོར་ལོ་བརྩེགས་པའི་རྣམ་པ་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00592",
      "source_tibetan": "ལྔ་དང་དགུ་ཡིས་ཡོངས་སུ་བརྩེགས། །",
      "reading_tibetan": "ལྔ་དང་དགུ་ཡིས་ཡོངས་སུ་བརྩེགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00593",
      "source_tibetan": "འཆར་ཁ་ཆུན་འཕྱང་རྣམས་ཀྱིས་བརྒྱན། །",
      "reading_tibetan": "འཆར་ཁ་ཆུན་འཕྱང་རྣམས་ཀྱིས་བརྒྱན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00594",
      "source_tibetan": "འབྲུག་སྒྲོགས་གློག་དམར་ལྕེ་རྣམས་འབྱིན།",
      "reading_tibetan": "འབྲུག་སྒྲོགས་གློག་དམར་ལྕེ་རྣམས་འབྱིན། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00595",
      "source_tibetan": "སྟོན་པའི་བསྟན་པ་ལུང་གིས་བསྐོར། །",
      "reading_tibetan": "སྟོན་པའི་བསྟན་པ་ལུང་གིས་བསྐོར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00596",
      "source_tibetan": "འོད་འབྱུང་ཕྲེང་བ་ཀླུ་ཡི་གླུ་ཡང་གདུང་ཡང་བྱུང་གདོང་། །",
      "reading_tibetan": "འོད་འབྱུང་ཕྲེང་བ་ཀླུ་ཡི་གདོང། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00597",
      "source_tibetan": "ཕྱོགས་དང་མཚམས་ཀུན་གསལ་བའོ། །",
      "reading_tibetan": "ཕྱོགས་དང་མཚམས་ཀུན་གསལ་བའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00598",
      "source_tibetan": "དྲིས་ལན་དྲུག་པ།",
      "reading_tibetan": "དྲིས་ལན་དྲུག་པ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
