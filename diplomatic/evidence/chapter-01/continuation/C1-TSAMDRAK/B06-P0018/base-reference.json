      "source_tibetan": "རྒྱལ་མཚན་གདུགས་ལ་སོགས་པ་བསྒྲེང༌། །",
      "reading_tibetan": "རྒྱལ་མཚན་གདུགས་ལ་སོགས་པ་བསྒྲེང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00556",
      "source_tibetan": "མེ་ཏོག་སིལ་མའི་ཆར་དང་དྲི། །",
      "reading_tibetan": "མེ་ཏོག་སིལ་མའི་ཆར་དང་དྲི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00557",
      "source_tibetan": "སྟོན་པ་ཉིད་དང་བསྟན་པ་ལ། །",
      "reading_tibetan": "སྟོན་པ་ཉིད་དང་བསྟན་པ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00558",
      "source_tibetan": "མཛེས་བྱེད་གཟུགས་བརྙན་ཚོགས་ཀྱིས་བསྐོར། །",
      "reading_tibetan": "མཛེས་བྱེད་གཟུགས་བརྙན་ཚོགས་ཀྱིས་བསྐོར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00559",
      "source_tibetan": "བདེ་བའི་རོལ་པ་འབྱུང་བའོ། །",
      "reading_tibetan": "བདེ་བའི་རོལ་པ་འབྱུང་བའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00560",
      "source_tibetan": "འདི་ནས་འཇིག་རྟེན་ལྷོ་ནུབ་གཡས། །",
      "reading_tibetan": "འདི་ནས་འཇིག་རྟེན་ལྷོ་ནུབ་གཡས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00561",
      "source_tibetan": "དྲུག་འདས་འོག་ན་ཐལ་བའི་རླུང་། །",
      "reading_tibetan": "དྲུག་འདས་འོག་ན་ཐལ་བའི་རླུང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00562",
      "source_tibetan": "གཡོ་ཞིང་སྤྱོད་པ་བར་སྣང་ལ། །",
      "reading_tibetan": "གཡོ་ཞིང་སྤྱོད་པ་བར་སྣང་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00563",
      "source_tibetan": "ཕན་ཚུན་གཡོ་ཞིང་ལྡིང་བ་དང༌། །",
      "reading_tibetan": "ཕན་ཚུན་གཡོ་ཞིང་ལྡིང་བ་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00564",
      "source_tibetan": "བསྐྱོད་པ་ལས་ནི་སྒྲ་རྣམས་འབྱུང༌། །",
      "reading_tibetan": "བསྐྱོད་པ་ལས་ནི་སྒྲ་རྣམས་འབྱུང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00565",
      "source_tibetan": "སྟོན་པའི་བསྟན་པ་རླུང་གིས་གཡོ། །",
      "reading_tibetan": "སྟོན་པའི་བསྟན་པ་རླུང་གིས་གཡོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00566",
      "source_tibetan": "ལྔ་ལྡན་འཇུག་པ་གསུམ་ཡིན་ནོ། །",
      "reading_tibetan": "ལྔ་ལྡན་འཇུག་པ་གསུམ་ཡིན་ནོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
