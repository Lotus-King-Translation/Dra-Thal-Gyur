      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00621",
      "source_tibetan": "སྒྲ་དོན་བརྗོད་བྱའི་ཚིག་ཙམ་ལས། །",
      "reading_tibetan": "སྒྲ་དོན་བརྗོད་བྱའི་ཚིག་ཙམ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00622",
      "source_tibetan": "འབྲེལ་དང་འབྲེལ་མེད་མཚན་ཉིད་ཀྱིས། །",
      "reading_tibetan": "འབྲེལ་དང་འབྲེལ་མེད་མཚན་ཉིད་ཀྱིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00623",
      "source_tibetan": "ཁྱབ་བྱའི་དོན་རྣམས་ཐལ་འགྱུར་བརྩིའོ། །",
      "reading_tibetan": "ཁྱབ་བྱའི་དོན་རྣམས་ཐལ་འགྱུར་བརྩིའོ། །",
