      "reading_tibetan": "འཕེན་ལ་རླུང་སྟེ་འཕོ་བའི་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00626",
      "source_tibetan": "ཚིག་དང་ཟུར་ལ་གཞོན་གཞོག་ཀྱང་པ་དང༌། །",
