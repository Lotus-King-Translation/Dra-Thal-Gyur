      "source_tibetan": "སྒྲ་དོན་དེ་ལྟར་དགོས་པ་འགྲུབ། །",
      "reading_tibetan": "སྒྲ་དོན་དེ་ལྟར་དགོས་པ་འགྲུབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00491",
      "source_tibetan": "རྒྱུད་ལ་ངེས་པའི་འཕྲུལ་འབྱེད་ཕྱེ། །",
      "reading_tibetan": "རྒྱུད་ལ་ངེས་པའི་འཕྲུལ་འབྱེད་ཕྱེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00492",
      "source_tibetan": "དྲིས་ལན་ལྔ་པ།",
      "reading_tibetan": "དྲིས་ལན་ལྔ་པ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00493",
      "source_tibetan": "ཐལ་བའི་གནས་ནི་རྣམ་པ་བརྒྱད། །",
      "reading_tibetan": "ཐལ་བའི་གནས་ནི་རྣམ་པ་བརྒྱད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00494",
      "source_tibetan": "འཇིག་རྟེན་ཁམས་དང་ཞིང་ཁམས་དང་། །",
      "reading_tibetan": "འཇིག་རྟེན་ཁམས་དང་ཞིང་ཁམས་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00495",
      "source_tibetan": "དམ་བཅའ་སྐྱོན་དང་སྐྱོན་གནས་དང་། །",
      "reading_tibetan": "དམ་བཅའ་སྐྱོན་དང་སྐྱོན་གནས་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00496",
      "source_tibetan": "འཕེན་པའི་ལས་དང་སྦྱོར་བ་དང་། །",
      "reading_tibetan": "འཕེན་པའི་ལས་དང་སྦྱོར་བ་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00497",
      "source_tibetan": "གྲགས་དང་སོང་བའི་གནད་དང་བརྒྱད། །",
      "reading_tibetan": "གྲགས་དང་སོང་བའི་གནད་དང་བརྒྱད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00498",
      "source_tibetan": "འདི་རྣམས་ཐལ་བའི་གནས་སུ་འདོད། །",
      "reading_tibetan": "འདི་རྣམས་ཐལ་བའི་གནས་སུ་འདོད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00499",
      "source_tibetan": "འཇིག་རྟེན་ཁམས་ནི་ཆགས་པ་དང༌། །",
      "reading_tibetan": "འཇིག་རྟེན་ཁམས་ནི་ཆགས་པ་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00500",
      "source_tibetan": "གནས་པ་ཉིད་དང་འཇིག་པའི་དུས། །",
      "reading_tibetan": "གནས་པ་ཉིད་དང་འཇིག་པའི་དུས། །",
      "status": "lexically_compared_punctuation_not_certified"
