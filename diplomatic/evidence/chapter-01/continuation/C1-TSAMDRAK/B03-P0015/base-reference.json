      "reading_tibetan": "དེ་དག་ཉིད་ལ་བརྒྱ་བརྒྱ་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00421",
      "source_tibetan": "ངེས་འབྱེད་འཕྲུལ་གྱི་རྣམ་པ་ལས། །",
      "reading_tibetan": "ངེས་འབྱེད་འཕྲུལ་གྱི་རྣམ་པ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00422",
      "source_tibetan": "གྲངས་དེ་དེ་ཡིས་བརྗོད་ཤེས་ན། །",
      "reading_tibetan": "གྲངས་དེ་དེ་ཡིས་བརྗོད་ཤེས་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00423",
      "source_tibetan": "རྒྱུད་དུ་མངོན་པར་ཤེས་པ་འགྲུབ། །",
      "reading_tibetan": "རྒྱུད་དུ་མངོན་པར་ཤེས་པ་འགྲུབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00424",
      "source_tibetan": "པིང་ཀ་ལ་ཡི་སྒྲ་དབྱངས་ཀྱིས། །",
      "reading_tibetan": "པིང་ཀ་ལ་ཡི་སྒྲ་དབྱངས་ཀྱིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00425",
      "source_tibetan": "ལུས་ལ་བརྒྱ་དང་ཉི་ཤུ་ལ། །",
      "reading_tibetan": "ལུས་ལ་བརྒྱ་དང་ཉི་ཤུ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00426",
      "source_tibetan": "དེ་བཞིན་ངག་དང་སེམས་ལ་ཡང་། །",
      "reading_tibetan": "དེ་བཞིན་ངག་དང་སེམས་ལ་ཡང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00427",
      "source_tibetan": "གོང་མ་ཙམ་སྟེ་ངེས་བརྗོད་གསུངས། །",
      "reading_tibetan": "གོང་མ་ཙམ་སྟེ་ངེས་བརྗོད་གསུངས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00428",
      "source_tibetan": "འཇིག་རྟེན་པ་ཡི་ལྷ་རྣམས་དང༌། །",
      "reading_tibetan": "འཇིག་རྟེན་པ་ཡི་ལྷ་རྣམས་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00429",
      "source_tibetan": "དེ་བཞིན་འདས་པའི་ལྷ་དག་དང༌། །",
      "reading_tibetan": "དེ་བཞིན་འདས་པའི་ལྷ་དག་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00430",
      "source_tibetan": "མཁའ་འགྲོ་མ་རྣམས་འདུས་པ་ཡིས། །",
      "reading_tibetan": "མཁའ་འགྲོ་མ་རྣམས་འདུས་པ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00431",
      "source_tibetan": "སྒྲ་ཡི་བྱེ་བྲག་རྣམ་ཤེས་ན། །",
      "reading_tibetan": "སྒྲ་ཡི་བྱེ་བྲག་རྣམ་ཤེས་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00432",
      "source_tibetan": "དེ་རྣམས་སྐད་ནི་ཤེས་པ་དང་། །",
      "reading_tibetan": "དེ་རྣམས་སྐད་ནི་ཤེས་པ་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00433",
      "source_tibetan": "མངོན་ཤེས་དྲུག་ལ་ངེས་སྤྱད་ན། །",
      "reading_tibetan": "མངོན་ཤེས་དྲུག་ལ་ངེས་སྤྱད་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00434",
      "source_tibetan": "བདེ་གཤེགས་བཀའ་ཡི་དོན་རྣམས་ཤེས། །",
      "reading_tibetan": "བདེ་གཤེགས་བཀའ་ཡི་དོན་རྣམས་ཤེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00435",
      "source_tibetan": "ཚིགས་སུ་བཅད་པའི་གྲངས་ཀྱིས་སུ། །",
      "reading_tibetan": "ཚིགས་སུ་བཅད་པའི་གྲངས་ཀྱིས་སུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00436",
      "source_tibetan": "སོ་སོར་གནས་དང་ངེས་པར་སྦྱོར། །",
      "reading_tibetan": "སོ་སོར་གནས་དང་ངེས་པར་སྦྱོར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00437",
      "source_tibetan": "དེ་ནས་ཆུ་ཡི་སྒྲ་ལ་ཡང༌། །",
      "reading_tibetan": "དེ་ནས་ཆུ་ཡི་སྒྲ་ལ་ཡང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00438",
      "source_tibetan": "སྙན་བརྗོད་གསུང་ནི་བསམ་མི་ཁྱབ། །",
      "reading_tibetan": "སྙན་བརྗོད་གསུང་ནི་བསམ་མི་ཁྱབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00439",
      "source_tibetan": "མཁས་པས་ཆོ་ག་རྫོགས་པའོ། །",
      "reading_tibetan": "མཁས་པས་ཆོ་ག་རྫོགས་པའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00440",
      "source_tibetan": "འབྱུང་བ་རྣམས་ཀྱི་སྒྲ་དོན་ནི། །",
      "reading_tibetan": "འབྱུང་བ་རྣམས་ཀྱི་སྒྲ་དོན་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00441",
      "source_tibetan": "དཔའ་དང་དཔའ་བར་འགྲོ་བ་ཡིས། །",
      "reading_tibetan": "དཔའ་དང་དཔའ་བར་འགྲོ་བ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00442",
      "source_tibetan": "ས་ཆུ་མེ་རླུང་བཞི་དག་ལ། །",
      "reading_tibetan": "ས་ཆུ་མེ་རླུང་བཞི་དག་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00443",
      "source_tibetan": "རེ་རེ་ལ་ཡང་གཉིས་གཉིས་ཏེ། །",
      "reading_tibetan": "རེ་རེ་ལ་ཡང་གཉིས་གཉིས་ཏེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
