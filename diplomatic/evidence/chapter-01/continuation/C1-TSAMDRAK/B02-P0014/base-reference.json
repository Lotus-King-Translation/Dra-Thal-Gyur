      "reading_tibetan": "སྒྲ་ཡི་བབ་སོ་རྣམ་པ་ལྔ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00406",
      "source_tibetan": "ཚངས་དང་ཁྱབ་འཇུག་པིང་ཀ་དང༌། །",
      "reading_tibetan": "ཚངས་དང་ཁྱབ་འཇུག་པིང་ཀ་དང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00407",
      "source_tibetan": "འབྱུང་བའི་སྒྲ་དང་སྟོན་པའི་གསུངས། །",
      "reading_tibetan": "འབྱུང་བའི་སྒྲ་དང་སྟོན་པའི་གསུངས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00408",
      "source_tibetan": "ལྔ་ཡིས་འབྱུང་བའི་ཆོས་རྣམས་ལ། །",
      "reading_tibetan": "ལྔ་ཡིས་འབྱུང་བའི་ཆོས་རྣམས་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00409",
      "source_tibetan": "ཅི་དགར་རོལ་པ་ཆེན་པོར་སྤྱད། །",
      "reading_tibetan": "ཅི་དགར་རོལ་པ་ཆེན་པོར་སྤྱད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00410",
      "source_tibetan": "ཚངས་པའི་གནས་ནི་ལྔ་པོ་ལ། །",
      "reading_tibetan": "ཚངས་པའི་གནས་ནི་ལྔ་པོ་ལ། །",
