    {
      "id": "U00963",
      "source_tibetan": "གདོན་མི་ཟ་བར་འཚང་རྒྱ་ངེས། །",
      "reading_tibetan": "གདོན་མི་ཟ་བར་འཚང་རྒྱ་ངེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00964",
      "source_tibetan": "རྒྱུད་འདི་སུས་ནི་རྟག་བཀླགས་ན། །",
      "reading_tibetan": "རྒྱུད་འདི་སུས་ནི་རྟག་བཀླགས་ན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00965",
      "source_tibetan": "དེས་ཀྱང་གོང་མ་བཞིན་དུ་འགྱུར། །",
      "reading_tibetan": "དེས་ཀྱང་གོང་མ་བཞིན་དུ་འགྱུར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00966",
      "source_tibetan": "བཀའ་གསང་ངེས་པ་བཅུ་བདུན་དང་། །",
      "reading_tibetan": "བཀའ་གསང་ངེས་པ་བཅུ་བདུན་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00967",
      "source_tibetan": "བསྟན་པའི་གཟེར་དང་འཕྲུལ་ཡིག་བཅས། །",
      "reading_tibetan": "བསྟན་པའི་གཟེར་དང་འཕྲུལ་ཡིག་བཅས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00968",
      "source_tibetan": "སྤྲུལ་སྐུའི་ཞིང་ཁམས་ཐོག་མ་ལ། །",
      "reading_tibetan": "སྤྲུལ་སྐུའི་ཞིང་ཁམས་ཐོག་མ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00969",
      "source_tibetan": "སྟོན་པ་ཀུན་ཏུ་བཟང་པོ་ཡིས། །",
      "reading_tibetan": "སྟོན་པ་ཀུན་ཏུ་བཟང་པོ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00970",
      "source_tibetan": "སྟུག་པོ་བཀོད་པའི་གནས་སུ་གསུངས། །",
      "reading_tibetan": "སྟུག་པོ་བཀོད་པའི་གནས་སུ་གསུངས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00971",
      "source_tibetan": "དེ་ནས་ལྕང་ལོ་ཅན་གྱི་གནས། །",
      "reading_tibetan": "དེ་ནས་ལྕང་ལོ་ཅན་གྱི་གནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00972",
      "source_tibetan": "ཀུན་གཟིགས་རྣམ་པར་སྣང་མཛད་ཀྱིས། །",
      "reading_tibetan": "ཀུན་གཟིགས་རྣམ་པར་སྣང་མཛད་ཀྱིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00973",
      "source_tibetan": "འདི་ཉིད་བཟུང་བས་རིགས་ལྔར་སྨིན། །",
      "reading_tibetan": "འདི་ཉིད་བཟུང་བས་རིགས་ལྔར་སྨིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00974",
      "source_tibetan": "དེ་འདས་ང་ཡིས་བཟུང་བ་ཡིས། །",
      "reading_tibetan": "དེ་འདས་ང་ཡིས་བཟུང་བ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00975",
      "source_tibetan": "བསྟན་པའི་སྲོག་ཤིང་དམ་པ་ཡི། །",
      "reading_tibetan": "བསྟན་པའི་སྲོག་ཤིང་དམ་པ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
