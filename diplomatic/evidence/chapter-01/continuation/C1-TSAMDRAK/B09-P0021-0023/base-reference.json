      "reading_tibetan": "ཡོན་ཏན་རྫོགས་པའི་སེམས་ཉིད་ལུང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00689",
      "source_tibetan": "ལྔ་པ་བལྟ་བསྒོམ་བཀོད་པ་སྟེ། །",
      "reading_tibetan": "ལྔ་པ་བལྟ་བསྒོམ་བཀོད་པ་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00690",
      "source_tibetan": "བྱ་བྲལ་རྫོགས་པ་དབྱིངས་ཀྱི་གནད། །",
      "reading_tibetan": "བྱ་བྲལ་རྫོགས་པ་དབྱིངས་ཀྱི་གནད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00691",
      "source_tibetan": "དྲུག་པ་སྐུ་རྣམས་བཀོད་པ་སྟེ། །",
      "reading_tibetan": "དྲུག་པ་སྐུ་རྣམས་བཀོད་པ་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00692",
      "source_tibetan": "ཡོན་ཏན་རྫོགས་པ་གསང་བའི་གཞི། །",
      "reading_tibetan": "ཡོན་ཏན་རྫོགས་པ་གསང་བའི་གཞི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00693",
      "source_tibetan": "དེ་ལྟར་དྲུག་གིས་སྐུ་གསུམ་གྱི། །",
      "reading_tibetan": "དེ་ལྟར་དྲུག་གིས་སྐུ་གསུམ་གྱི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00694",
      "source_tibetan": "འབྲས་བུ་ཐོབ་པ་དེ་དག་གོ། །",
      "reading_tibetan": "འབྲས་བུ་ཐོབ་པ་དེ་དག་གོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00695",
      "source_tibetan": "ཚད་བསྟན་ལེའུ་གྱུར་དག་ཤེས། །",
      "reading_tibetan": "ཚད་བསྟན་ལེའུ་གྱུར་དག་ཤེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00696",
      "source_tibetan": "དཔལ་གྱི་དགོངས་པ་འབྱུང་བའི་གཏེར། །",
      "reading_tibetan": "དཔལ་གྱི་དགོངས་པ་འབྱུང་བའི་གཏེར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00697",
      "source_tibetan": "བདེ་བ་ཐབས་ཀྱི་སྐུ་ཉིད་ཀྱང༌། །",
      "reading_tibetan": "བདེ་བ་ཐབས་ཀྱི་སྐུ་ཉིད་ཀྱང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00698",
      "source_tibetan": "ལུང་བསྟན་རྗེས་འཛིན་སེམས་ཀྱི་གནད། །",
      "reading_tibetan": "ལུང་བསྟན་རྗེས་འཛིན་སེམས་ཀྱི་གནད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00699",
      "source_tibetan": "འགྲོ་བ་བདག་སྐྱོབ་རླུང་གི་ལྷ། །",
      "reading_tibetan": "འགྲོ་བ་བདག་སྐྱོབ་རླུང་གི་ལྷ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00700",
      "source_tibetan": "ལྷག་མ་ཉིད་ཀྱང་དེ་ཙམ་མོ། །",
      "reading_tibetan": "ལྷག་མ་ཉིད་ཀྱང་དེ་ཙམ་མོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
  ],
