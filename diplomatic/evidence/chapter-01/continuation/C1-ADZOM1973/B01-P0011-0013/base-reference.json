      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00043",
      "source_tibetan": "སྟོན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས། །",
      "reading_tibetan": "སྟོན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00044",
      "source_tibetan": "ལོ་བརྒྱད་མཛེས་པའི་གཟུགས་སུ་སྤྲུལ། །",
      "reading_tibetan": "ལོ་བརྒྱད་མཛེས་པའི་གཟུགས་སུ་སྤྲུལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00045",
      "source_tibetan": "གཟིགས་སྟངས་གསུམ་ལས་སྟོན་པའི་སྐུ། །",
      "reading_tibetan": "གཟིགས་སྟངས་གསུམ་ལས་སྟོན་པའི་སྐུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00046",
      "source_tibetan": "སྣང་ བའི་འོད་ནི་བསམ་མི་ཁྱབ། །",
      "reading_tibetan": "སྣང་ བའི་འོད་ནི་བསམ་མི་ཁྱབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00047",
      "source_tibetan": "སྤྲུལ་པ་མཛད་པ་དང་པོར་བྱུང་། །",
      "reading_tibetan": "སྤྲུལ་པ་མཛད་པ་དང་པོར་བྱུང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00048",
      "source_tibetan": "རྒྱུད་འབྱུང་གླེང་གཞི་དང་པོ་ལ། །",
      "reading_tibetan": "རྒྱུད་འབྱུང་གླེང་གཞི་དང་པོ་ལ། །",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00049",
      "source_tibetan": "ལྔ་པོ་རྣམས་ཀྱི་ས་བོན་འཛིན། །",
      "reading_tibetan": "ལྔ་པོ་རྣམས་ཀྱི་ས་བོན་འཛིན། །",
      "status": "uncertain_print_reading_or_annotation"
    },
    {
      "id": "U00050",
      "source_tibetan": "གདུལ་བྱ་བརྫུས་ནས་སྐྱེས་པ་ལ། །",
      "reading_tibetan": "གདུལ་བྱ་བརྫུས་ནས་སྐྱེས་པ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00051",
      "source_tibetan": "ཁ་དོག་དཀར་ཞིང་ཤ་གཟུགས་བྲལ། །",
      "reading_tibetan": "ཁ་དོག་དཀར་ཞིང་ཤ་གཟུགས་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00052",
      "source_tibetan": "ཟང་ཐལ་དྲི་མ་མེད་པའི་སྐུ། །",
      "reading_tibetan": "ཟང་ཐལ་དྲི་མ་མེད་པའི་སྐུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00053",
      "source_tibetan": "ཉོན་མོངས་རགས་པ་རང་དག་སྟེ། །",
      "reading_tibetan": "ཉོན་མོངས་རགས་པ་རང་དག་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00054",
      "source_tibetan": "བག་ལ་ཉལ་བ་མ་ཡིན་པས། །",
      "reading_tibetan": "བག་ལ་ཉལ་བ་མ་ཡིན་པས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00055",
      "source_tibetan": "མངོན་པར་རྒྱུ་བ་རྣམ་གཉིས་བྲལ། །",
      "reading_tibetan": "མངོན་པར་རྒྱུ་བ་རྣམ་གཉིས་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00056",
      "source_tibetan": "དབང་པོ་ལྔ་ནི་རང་གསལ་ལ། །",
      "reading_tibetan": "དབང་པོ་ལྔ་ནི་རང་གསལ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00057",
      "source_tibetan": "མཚན་མ་རྣམས་ནི་སྦུབས་སུ་ནུབ། །",
      "reading_tibetan": "མཚན་མ་རྣམས་ནི་སྦུབས་སུ་ནུབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00058",
      "source_tibetan": "དབུགས་ལ་བརྟེན་པའི་འགྲོ་འོང་ཟད། །",
      "reading_tibetan": "དབུགས་ལ་བརྟེན་པའི་འགྲོ་འོང་ཟད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00059",
      "source_tibetan": "བར་སྣང་དག་ལ་གནས་བཅས་ནས། །",
      "reading_tibetan": "བར་སྣང་དག་ལ་གནས་བཅས་ནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00060",
      "source_tibetan": "ཕན་ཚུན་འཁོར་དང་ལངས་པར་བྱེད། །",
      "reading_tibetan": "ཕན་ཚུན་འཁོར་དང་ལངས་པར་བྱེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00061",
      "source_tibetan": "འགྲོ་དང་འགྲེང་དང་ཉལ་བ་དང་། །",
      "reading_tibetan": "འགྲོ་དང་འགྲེང་དང་ཉལ་བ་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00062",
      "source_tibetan": "བསྐྱོད་ཅིང་རྒྱུག་པའི་རྣམ་པ་རྣམས། །",
      "reading_tibetan": "བསྐྱོད་ཅིང་རྒྱུག་པའི་རྣམ་པ་རྣམས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00063",
      "source_tibetan": "བར་སྣང་ཉིད་ལས་གཞན་ཅི་མིན། །",
      "reading_tibetan": "བར་སྣང་ཉིད་ལས་གཞན་ཅི་མིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00064",
      "source_tibetan": "རང་ལས་འོད་བྱུང་སྣང་བ་ལས། །",
      "reading_tibetan": "རང་ལས་འོད་བྱུང་སྣང་བ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00065",
      "source_tibetan": "ཉི་ཟླ་ལ་སོགས་འོད་མི་སྣང༌། །",
      "reading_tibetan": "ཉི་ཟླ་ལ་སོགས་འོད་མི་སྣང༌། །",
