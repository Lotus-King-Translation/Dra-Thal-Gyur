  "base_units": [
    {
      "id": "U00100",
      "source_tibetan": "དེས་ན་རྫོགས་ཆེན་བྱ་རྩོལ་བྲལ། །",
      "reading_tibetan": "དེས་ན་རྫོགས་ཆེན་བྱ་རྩོལ་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00101",
      "source_tibetan": "གཞན་འབད་པ་ལས་བྱུང་བ་མིན། །",
      "reading_tibetan": "གཞན་འབད་པ་ལས་བྱུང་བ་མིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00102",
      "source_tibetan": "སངས་རྒྱས་བརྗོད་དུ་མེད་པ་ཡིས། །",
      "reading_tibetan": "སངས་རྒྱས་བརྗོད་དུ་མེད་པ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00103",
      "source_tibetan": "ཡེ་ཐོག་ནས་ནི་ཕྱག་མཛད་པའི། །",
      "reading_tibetan": "ཡེ་ཐོག་ནས་ནི་ཕྱག་མཛད་པའི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00104",
      "source_tibetan": "ཆོས་ཀྱི་སྐུ་ལ་ངེས་བརྒྱུད་དེ། །",
      "reading_tibetan": "ཆོས་ཀྱི་སྐུ་ལ་ངེས་བརྒྱུད་དེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00105",
      "source_tibetan": "ལས་ཅན་སྣང་བར་བྱེད་དོན་དུ།",
      "reading_tibetan": "ལས་ཅན་སྣང་བར་བྱེད་དོན་དུ། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00106",
      "source_tibetan": " སྤྲུལ་པའི་ས་བོན་ལྡང་བའོ། །",
      "reading_tibetan": " སྤྲུལ་པའི་ས་བོན་ལྡང་བའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00107",
      "source_tibetan": "དེ་ལྟར་དངོས་ཀྱི་བསྟན་པ་ལས། །",
      "reading_tibetan": "དེ་ལྟར་དངོས་ཀྱི་བསྟན་པ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00108",
      "source_tibetan": "གཟུགས་བརྙན་ཆོ་འཕྲུལ་འདི་ལྟ་བུ། །",
      "reading_tibetan": "གཟུགས་བརྙན་ཆོ་འཕྲུལ་འདི་ལྟ་བུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00109",
      "source_tibetan": "སུས་ཀྱང་བརྗོད་དུ་མེད་པར་ནི། །",
      "reading_tibetan": "སུས་ཀྱང་བརྗོད་དུ་མེད་པར་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00110",
      "source_tibetan": "ནམ་མཁའ་མི་འབྱེད་བར་སྣང་ལས། །",
      "reading_tibetan": "ནམ་མཁའ་མི་འབྱེད་བར་སྣང་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00111",
      "source_tibetan": "ཚིག་རྣམས་ཀུན་གྱི་ཐོག་མར་ཡང༌། །",
      "reading_tibetan": "ཚིག་རྣམས་ཀུན་གྱི་ཐོག་མར་ཡང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00112",
      "source_tibetan": "དགུ་གཉིས་བཞི་ཡི་ཡང་སྟེང་ནས། །",
      "reading_tibetan": "དགུ་གཉིས་བཞི་ཡི་ཡང་སྟེང་ནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00113",
      "source_tibetan": "ཚངས་པ་ཆེན་པོའི་དབྱངས་སུ་བསྒྲགས། །",
      "reading_tibetan": "ཚངས་པ་ཆེན་པོའི་དབྱངས་སུ་བསྒྲགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00114",
      "source_tibetan": "དེ་ནས་ཆོས་ཉིད་ནམ་མཁའ་ལས། །",
      "reading_tibetan": "དེ་ནས་ཆོས་ཉིད་ནམ་མཁའ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00115",
      "source_tibetan": "ཁྱབ་འཇུག་ཆེན་པོའི་གསུང་གིས་ནི། །",
      "reading_tibetan": "ཁྱབ་འཇུག་ཆེན་པོའི་གསུང་གིས་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00116",
      "source_tibetan": "བྱིན་གྱིས་རླབས་ཀྱིས་རང་སྒྲར་སྟོན། །",
      "reading_tibetan": "བྱིན་གྱིས་རླབས་ཀྱིས་རང་སྒྲར་སྟོན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00117",
      "source_tibetan": "དེ་ནས་ཕྱོགས་བྲལ་ནམ་མཁའ་ལས། །",
      "reading_tibetan": "དེ་ནས་ཕྱོགས་བྲལ་ནམ་མཁའ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00118",
      "source_tibetan": "ཀ་ལ་པིང་ཀའི་སྒྲ་དབྱངས་ལས། །",
      "reading_tibetan": "ཀ་ལ་པིང་ཀའི་སྒྲ་དབྱངས་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00119",
      "source_tibetan": "བསྟན་པ་ཀུན་གྱི་བཅུད་བསྡུས་པའི། །",
      "reading_tibetan": "བསྟན་པ་ཀུན་གྱི་བཅུད་བསྡུས་པའི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00120",
      "source_tibetan": "རྒྱུད་ཀྱི་རྒྱལ་པོ་འདི་ཉིད་ནི། །",
      "reading_tibetan": "རྒྱུད་ཀྱི་རྒྱལ་པོ་འདི་ཉིད་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00121",
      "source_tibetan": "ཚིག་རྣམས་ཀུན་གྱི་ཐོག་མར་ཡང་། །",
      "reading_tibetan": "ཚིག་རྣམས་ཀུན་གྱི་ཐོག་མར་ཡང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00122",
      "source_tibetan": "བརྒྱ་ཕྲག་གསུམ་དང་དྲུག་ཅུ་ཡི། །",
      "reading_tibetan": "བརྒྱ་ཕྲག་གསུམ་དང་དྲུག་ཅུ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00123",
      "source_tibetan": "སྒྲ་ལས་དྲངས་ཏེ་སྟོན་པས་གསུངས། །",
      "reading_tibetan": "སྒྲ་ལས་དྲངས་ཏེ་སྟོན་པས་གསུངས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00124",
      "source_tibetan": "དེ་ནས་འབྱུང་བ་སོ་སོའི་སྒྲ། །",
      "reading_tibetan": "དེ་ནས་འབྱུང་བ་སོ་སོའི་སྒྲ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00125",
      "source_tibetan": "བྱེད་རྒྱུ་ཚ་དང་གྲང་བ་ལས། །",
      "reading_tibetan": "བྱེད་རྒྱུ་ཚ་དང་གྲང་བ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00126",
      "source_tibetan": "སོ་སོའི་སྒྲ་དབྱངས་སྟོང་ཕྲག་བརྒྱད། །",
      "reading_tibetan": "སོ་སོའི་སྒྲ་དབྱངས་སྟོང་ཕྲག་བརྒྱད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00127",
      "source_tibetan": "སྟོན་པས་བྱིན་གྱིས་བརླབས་པར་སྣང་། །",
      "reading_tibetan": "སྟོན་པས་བྱིན་གྱིས་བརླབས་པར་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00128",
      "source_tibetan": "ཁྱད་པར་འབྱེད་རྒྱུའི་གསུང་ལ་ཡང༌། །",
      "reading_tibetan": "ཁྱད་པར་འབྱེད་རྒྱུའི་གསུང་ལ་ཡང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00129",
      "source_tibetan": "སྒྲ་ཚིག་རྣམས་ནི་འབྱུང་བའི་གཞི། །",
      "reading_tibetan": "སྒྲ་ཚིག་རྣམས་ནི་འབྱུང་བའི་གཞི། །",
