  "warning": "Base reference only, never evidence of comparison-witness agreement",
  "base_units": [
    {
      "id": "U00025",
      "source_tibetan": "སོ་སོའི་ཉམས་དང་མཐུན་པར་བཤད། །",
      "reading_tibetan": "སོ་སོའི་ཉམས་དང་མཐུན་པར་བཤད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00026",
      "source_tibetan": "འདས་དང་མ་འོངས་ད་ལྟར་མེད། །",
      "reading_tibetan": "འདས་དང་མ་འོངས་ད་ལྟར་མེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00027",
      "source_tibetan": "མི་ཕྱེད་འབྱེད་པ་ཡོངས་སུ་མེད། །",
      "reading_tibetan": "མི་ཕྱེད་འབྱེད་པ་ཡོངས་སུ་མེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00028",
      "source_tibetan": "ཐམས་ཅད་རང་བྱུང་ཡེ་ཤེས་སོ། །",
      "reading_tibetan": "ཐམས་ཅད་རང་བྱུང་ཡེ་ཤེས་སོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00029",
      "source_tibetan": "ཐུན་མོང་གི་གླེང་གཞི་བཀོད་པ།",
      "reading_tibetan": "ཐུན་མོང་གི་གླེང་གཞི་བཀོད་པ།",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00030",
      "source_tibetan": "འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་གཅིག་ན།",
      "reading_tibetan": "འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་གཅིག་ན། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00031",
      "source_tibetan": " དགའ་དང་ལྡན་པ་བསོད་ནམས་བརྩེགས། །",
      "reading_tibetan": " དགའ་དང་ལྡན་པ་བསོད་ནམས་བརྩེགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00032",
      "source_tibetan": "འགྲོ་བ་རྣམས་ཀྱི་ཐོག་མའི་ཡུལ། །",
      "reading_tibetan": "འགྲོ་བ་རྣམས་ཀྱི་ཐོག་མའི་ཡུལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00033",
      "source_tibetan": "ས་དང་ཆུ་དང་མེ་རླུང་གི། །",
      "reading_tibetan": "ས་དང་ཆུ་དང་མེ་རླུང་གི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00034",
      "source_tibetan": "འབྱུང་བ་ཆེན་པོ་བཞི་མི་སྣང་། །",
      "reading_tibetan": "འབྱུང་བ་ཆེན་པོ་བཞི་མི་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00035",
      "source_tibetan": "ཤ་ཁྲག་བཀོད་པའི་གཟུགས་མེད་པའི།",
      "reading_tibetan": "ཤ་ཁྲག་བཀོད་པའི་གཟུགས་མེད་པའི། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00036",
      "source_tibetan": "རང་སྣང་དག་པ་ཆེན་པོའི་ཡུལ། །",
      "reading_tibetan": "རང་སྣང་དག་པ་ཆེན་པོའི་ཡུལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00037",
      "source_tibetan": "རབ་ཏུ་མཛེས་ཤིང་རྒྱས་པ་ཡི། །",
      "reading_tibetan": "རབ་ཏུ་མཛེས་ཤིང་རྒྱས་པ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00038",
      "source_tibetan": "པདྨའི་ཟེའུ་འབྲུ་རྫོགས་པའི་གྲངས། །",
      "reading_tibetan": "པདྨའི་ཟེའུ་འབྲུ་རྫོགས་པའི་གྲངས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00039",
      "source_tibetan": "སྟོད་དང་ལྡན་པ་དབུས་མའི་གནས། །",
      "reading_tibetan": "སྟོང་དང་ལྡན་པ་དབུས་མའི་གནས། །",
      "status": "scan_intervention"
    },
    {
      "id": "U00040",
      "source_tibetan": "ཡོན་ཏན་ཐམས་ཅད་རྫོགས་པ་ཡི། །",
      "reading_tibetan": "ཡོན་ཏན་ཐམས་ཅད་རྫོགས་པ་ཡི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00041",
      "source_tibetan": "རྐྱེན་བཞིས་སྨིན་པའི་གཟུགས་ཀྱི་སྐུ། །",
      "reading_tibetan": "རྐྱེན་བཞིས་སྨིན་པའི་གཟུགས་ཀྱི་སྐུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00042",
      "source_tibetan": "བརྫུས་ནས་སྐྱེས་པའི་ལུས་བླངས་ཏེ། །",
      "reading_tibetan": "བརྫུས་ནས་སྐྱེས་པའི་ལུས་བླངས་ཏེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00043",
      "source_tibetan": "སྟོན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས། །",
      "reading_tibetan": "སྟོན་པ་སངས་རྒྱས་བཅོམ་ལྡན་འདས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00044",
      "source_tibetan": "ལོ་བརྒྱད་མཛེས་པའི་གཟུགས་སུ་སྤྲུལ། །",
      "reading_tibetan": "ལོ་བརྒྱད་མཛེས་པའི་གཟུགས་སུ་སྤྲུལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00045",
      "source_tibetan": "གཟིགས་སྟངས་གསུམ་ལས་སྟོན་པའི་སྐུ། །",
      "reading_tibetan": "གཟིགས་སྟངས་གསུམ་ལས་སྟོན་པའི་སྐུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00046",
      "source_tibetan": "སྣང་ བའི་འོད་ནི་བསམ་མི་ཁྱབ། །",
      "reading_tibetan": "སྣང་ བའི་འོད་ནི་བསམ་མི་ཁྱབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00047",
      "source_tibetan": "སྤྲུལ་པ་མཛད་པ་དང་པོར་བྱུང་། །",
      "reading_tibetan": "སྤྲུལ་པ་མཛད་པ་དང་པོར་བྱུང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00048",
      "source_tibetan": "རྒྱུད་འབྱུང་གླེང་གཞི་དང་པོ་ལ། །",
      "reading_tibetan": "རྒྱུད་འབྱུང་གླེང་གཞི་དང་པོ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00049",
      "source_tibetan": "ལྔ་པོ་རྣམས་ཀྱི་ས་བོན་འཛིན། །",
      "reading_tibetan": "ལྔ་པོ་རྣམས་ཀྱི་ས་བོན་འཛིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00050",
      "source_tibetan": "གདུལ་བྱ་བརྫུས་ནས་སྐྱེས་པ་ལ། །",
      "reading_tibetan": "གདུལ་བྱ་བརྫུས་ནས་སྐྱེས་པ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00051",
      "source_tibetan": "ཁ་དོག་དཀར་ཞིང་ཤ་གཟུགས་བྲལ། །",
      "reading_tibetan": "ཁ་དོག་དཀར་ཞིང་ཤ་གཟུགས་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00052",
      "source_tibetan": "ཟང་ཐལ་དྲི་མ་མེད་པའི་སྐུ། །",
      "reading_tibetan": "ཟང་ཐལ་དྲི་མ་མེད་པའི་སྐུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00053",
      "source_tibetan": "ཉོན་མོངས་རགས་པ་རང་དག་སྟེ། །",
      "reading_tibetan": "ཉོན་མོངས་རགས་པ་རང་དག་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
  ],
