  "warning": "Base reference only, never evidence of comparison-witness agreement",
  "base_units": [
    {
      "id": "U00049",
      "source_tibetan": "ལྔ་པོ་རྣམས་ཀྱི་ས་བོན་འཛིན། །",
      "reading_tibetan": "ལྔ་པོ་རྣམས་ཀྱི་ས་བོན་འཛིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00050",
      "source_tibetan": "གདུལ་བྱ་བརྫུས་ནས་སྐྱེས་པ་ལ། །",
      "reading_tibetan": "གདུལ་བྱ་བརྫུས་ནས་སྐྱེས་པ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00051",
      "source_tibetan": "ཁ་དོག་དཀར་ཞིང་ཤ་གཟུགས་བྲལ། །",
      "reading_tibetan": "ཁ་དོག་དཀར་ཞིང་ཤ་གཟུགས་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00052",
      "source_tibetan": "ཟང་ཐལ་དྲི་མ་མེད་པའི་སྐུ། །",
      "reading_tibetan": "ཟང་ཐལ་དྲི་མ་མེད་པའི་སྐུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00053",
      "source_tibetan": "ཉོན་མོངས་རགས་པ་རང་དག་སྟེ། །",
      "reading_tibetan": "ཉོན་མོངས་རགས་པ་རང་དག་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00054",
      "source_tibetan": "བག་ལ་ཉལ་བ་མ་ཡིན་པས། །",
      "reading_tibetan": "བག་ལ་ཉལ་བ་མ་ཡིན་པས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00055",
      "source_tibetan": "མངོན་པར་རྒྱུ་བ་རྣམ་གཉིས་བྲལ། །",
      "reading_tibetan": "མངོན་པར་རྒྱུ་བ་རྣམ་གཉིས་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00056",
      "source_tibetan": "དབང་པོ་ལྔ་ནི་རང་གསལ་ལ། །",
      "reading_tibetan": "དབང་པོ་ལྔ་ནི་རང་གསལ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00057",
      "source_tibetan": "མཚན་མ་རྣམས་ནི་སྦུབས་སུ་ནུབ། །",
      "reading_tibetan": "མཚན་མ་རྣམས་ནི་སྦུབས་སུ་ནུབ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00058",
      "source_tibetan": "དབུགས་ལ་བརྟེན་པའི་འགྲོ་འོང་ཟད། །",
      "reading_tibetan": "དབུགས་ལ་བརྟེན་པའི་འགྲོ་འོང་ཟད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00059",
      "source_tibetan": "བར་སྣང་དག་ལ་གནས་བཅས་ནས། །",
      "reading_tibetan": "བར་སྣང་དག་ལ་གནས་བཅས་ནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00060",
      "source_tibetan": "ཕན་ཚུན་འཁོར་དང་ལངས་པར་བྱེད། །",
      "reading_tibetan": "ཕན་ཚུན་འཁོར་དང་ལངས་པར་བྱེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00061",
      "source_tibetan": "འགྲོ་དང་འགྲེང་དང་ཉལ་བ་དང་། །",
      "reading_tibetan": "འགྲོ་དང་འགྲེང་དང་ཉལ་བ་དང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00062",
      "source_tibetan": "བསྐྱོད་ཅིང་རྒྱུག་པའི་རྣམ་པ་རྣམས། །",
      "reading_tibetan": "བསྐྱོད་ཅིང་རྒྱུག་པའི་རྣམ་པ་རྣམས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00063",
      "source_tibetan": "བར་སྣང་ཉིད་ལས་གཞན་ཅི་མིན། །",
      "reading_tibetan": "བར་སྣང་ཉིད་ལས་གཞན་ཅི་མིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00064",
      "source_tibetan": "རང་ལས་འོད་བྱུང་སྣང་བ་ལས། །",
      "reading_tibetan": "རང་ལས་འོད་བྱུང་སྣང་བ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00065",
      "source_tibetan": "ཉི་ཟླ་ལ་སོགས་འོད་མི་སྣང༌། །",
      "reading_tibetan": "ཉི་ཟླ་ལ་སོགས་འོད་མི་སྣང༌། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00066",
      "source_tibetan": "གོས་མེད་འཇམ་པའི་ངང་ཚུལ་ཅན། །",
      "reading_tibetan": "གོས་མེད་འཇམ་པའི་ངང་ཚུལ་ཅན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00067",
      "source_tibetan": "མཛེས་ཞིང་ལྡེམ་བག་ལྡན་པ་ལ། །",
      "reading_tibetan": "མཛེས་ཞིང་ལྡེམ་བག་ལྡན་པ་ལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00068",
      "source_tibetan": "བག་ཡངས་རྣམ་ཤེས་གུད་མེད་པར། །",
      "reading_tibetan": "བག་ཡངས་རྣམ་ཤེས་གུད་མེད་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00069",
      "source_tibetan": "བསམ་གཏན་དང་པོར་གནས་པ་བཞིན། །",
      "reading_tibetan": "བསམ་གཏན་དང་པོར་གནས་པ་བཞིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00070",
      "source_tibetan": "མངོན་དུ་བྱ་དང་བྱེད་པ་བྲལ། །",
      "reading_tibetan": "མངོན་དུ་བྱ་དང་བྱེད་པ་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00071",
      "source_tibetan": "གཟུགས་མེད་ལས་ཀྱི་འགྱུར་བྱེད་ལྟར། །",
      "reading_tibetan": "གཟུགས་མེད་ལས་ཀྱི་འགྱུར་བྱེད་ལྟར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00072",
      "source_tibetan": "ཁམས་དང་གུད་བཅས་ལས་མི་སྣང་། །",
      "reading_tibetan": "ཁམས་དང་གུད་བཅས་ལས་མི་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00073",
      "source_tibetan": "ཁྱད་པར་སྙིང་པོའི་པདྨ་ལས། །",
      "reading_tibetan": "ཁྱད་པར་སྙིང་པོའི་པདྨ་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00074",
      "source_tibetan": "སྟོང་དང་རྩ་གཅིག་གཟུགས་རྣམས་ནི། །",
      "reading_tibetan": "སྟོང་དང་རྩ་གཅིག་གཟུགས་རྣམས་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00075",
      "source_tibetan": "འཇའ་ཚོན་སྒྱུ་མ་ཇི་བཞིན་དུ། །",
      "reading_tibetan": "འཇའ་ཚོན་སྒྱུ་མ་ཇི་བཞིན་དུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00076",
      "source_tibetan": "སངས་རྒྱས་རྣམས་ཀྱི་གཟུགས་སྐུའོ། །",
      "reading_tibetan": "སངས་རྒྱས་རྣམས་ཀྱི་གཟུགས་སྐུའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00077",
      "source_tibetan": "དེ་ཡི་ཁྱད་པར་སྟོན་པའི་གཟུགས། །",
      "reading_tibetan": "དེ་ཡི་ཁྱད་པར་སྟོན་པའི་གཟུགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00078",
      "source_tibetan": "རིས་ཅན་འོད་ཟེར་དཔག་ཏུ་མེད། །",
      "reading_tibetan": "རིས་ཅན་འོད་ཟེར་དཔག་ཏུ་མེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00079",
      "source_tibetan": "ང་ནི་ལྷ་བུ་དགའ་བྱེད་སྟེ། །",
      "reading_tibetan": "ང་ནི་ལྷ་བུ་དགའ་བྱེད་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00080",
      "source_tibetan": "དབང་ཕྱུག་རྫོགས་པའི་ལུས་བླངས་ནས། །",
      "reading_tibetan": "དབང་ཕྱུག་རྫོགས་པའི་ལུས་བླངས་ནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    }
  ],
