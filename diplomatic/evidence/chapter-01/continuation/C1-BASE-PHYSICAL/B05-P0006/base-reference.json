  "base_units": [
    {
      "id": "U00074",
      "source_tibetan": "སྟོང་དང་རྩ་གཅིག་གཟུགས་རྣམས་ནི། །",
      "reading_tibetan": "སྟོང་དང་རྩ་གཅིག་གཟུགས་རྣམས་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00075",
      "source_tibetan": "འཇའ་ཚོན་སྒྱུ་མ་ཇི་བཞིན་དུ། །",
      "reading_tibetan": "འཇའ་ཚོན་སྒྱུ་མ་ཇི་བཞིན་དུ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00076",
      "source_tibetan": "སངས་རྒྱས་རྣམས་ཀྱི་གཟུགས་སྐུའོ། །",
      "reading_tibetan": "སངས་རྒྱས་རྣམས་ཀྱི་གཟུགས་སྐུའོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00077",
      "source_tibetan": "དེ་ཡི་ཁྱད་པར་སྟོན་པའི་གཟུགས། །",
      "reading_tibetan": "དེ་ཡི་ཁྱད་པར་སྟོན་པའི་གཟུགས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00078",
      "source_tibetan": "རིས་ཅན་འོད་ཟེར་དཔག་ཏུ་མེད། །",
      "reading_tibetan": "རིས་ཅན་འོད་ཟེར་དཔག་ཏུ་མེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00079",
      "source_tibetan": "ང་ནི་ལྷ་བུ་དགའ་བྱེད་སྟེ། །",
      "reading_tibetan": "ང་ནི་ལྷ་བུ་དགའ་བྱེད་སྟེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00080",
      "source_tibetan": "དབང་ཕྱུག་རྫོགས་པའི་ལུས་བླངས་ནས། །",
      "reading_tibetan": "དབང་ཕྱུག་རྫོགས་པའི་ལུས་བླངས་ནས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00081",
      "source_tibetan": "སྟོན་པའི་གསུང་གི་འོད་ཟེར་ཁྱིམ། །",
      "reading_tibetan": "སྟོན་པའི་གསུང་གི་འོད་ཟེར་ཁྱིམ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00082",
      "source_tibetan": "རང་བཞིན་གྱིས་ནི་བདེ་བ་རྙེད། །",
      "reading_tibetan": "རང་བཞིན་གྱིས་ནི་བདེ་བ་རྙེད། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00083",
      "source_tibetan": "དེ་ཚེ་མཛད་པའི་བྱིན་རླབས་ལས། །",
      "reading_tibetan": "དེ་ཚེ་མཛད་པའི་བྱིན་རླབས་ལས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00084",
      "source_tibetan": "དྲུག་ཅུ་རྩ་བཞིའི་འོད་སྐར་ནི། །",
      "reading_tibetan": "དྲུག་ཅུ་རྩ་བཞིའི་འོད་སྐར་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00085",
      "source_tibetan": "བར་སྣང་ཉིད་ལས་གཟུགས་བཀོད་པར། །",
      "reading_tibetan": "བར་སྣང་ཉིད་ལས་གཟུགས་བཀོད་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00086",
      "source_tibetan": "སུས་ཀྱང་བྱས་པ་མེད་པར་སྣང་། །",
      "reading_tibetan": "སུས་ཀྱང་བྱས་པ་མེད་པར་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00087",
      "source_tibetan": "ཁྱད་པར་ཡང་ཞུན་བཅུ་བདུན་ནི། །",
      "reading_tibetan": "ཁྱད་པར་ཡང་ཞུན་བཅུ་བདུན་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00088",
      "source_tibetan": "བསྟན་པ་དམ་པ་རྫོགས་པའི་ཕྱིར། །",
      "reading_tibetan": "བསྟན་པ་དམ་པ་རྫོགས་པའི་ཕྱིར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00089",
      "source_tibetan": "སྐུ་གསུང་ཐུགས་ཀྱི་བསྟན་པ་དངོས། །",
      "reading_tibetan": "སྐུ་གསུང་ཐུགས་ཀྱི་བསྟན་པ་དངོས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00090",
      "source_tibetan": "རྡོ་རྗེ་བཅས་དང་སྐུ་གཟུགས་ནི། །",
      "reading_tibetan": "རྡོ་རྗེ་བཅས་དང་སྐུ་གཟུགས་ནི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00091",
      "source_tibetan": "སུས་ཀྱང་བྱས་པ་མ་ཡིན་པར། །",
      "reading_tibetan": "སུས་ཀྱང་བྱས་པ་མ་ཡིན་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00092",
      "source_tibetan": "ཡེ་ཐོག་ནས་ནི་རང་སྣང་བར། །",
      "reading_tibetan": "ཡེ་ཐོག་ནས་ནི་རང་སྣང་བར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00093",
      "source_tibetan": "སོ་སོའི་ལས་དང་སྐལ་མཐུན་པར། །",
      "reading_tibetan": "སོ་སོའི་ལས་དང་སྐལ་མཐུན་པར། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00094",
      "source_tibetan": "གསེར་གྱི་སྙིང་པོ་ཉིད་ལ་སྣང་། །",
      "reading_tibetan": "གསེར་གྱི་སྙིང་པོ་ཉིད་ལ་སྣང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00095",
      "source_tibetan": "ཀུན་དང་ལྷན་ཅིག་མ་ཡིན་ནོ། །",
      "reading_tibetan": "ཀུན་དང་ལྷན་ཅིག་མ་ཡིན་ནོ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00096",
      "source_tibetan": "དེས་ན་སྙིང་དང་འདྲ་བས་གསང་། །",
      "reading_tibetan": "དེས་ན་སྙིང་དང་འདྲ་བས་གསང་། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00097",
      "source_tibetan": "དངོས་གྲུབ་མཆོག་རྣམས་མཐར་ཐུག་པའི། །",
      "reading_tibetan": "དངོས་གྲུབ་མཆོག་རྣམས་མཐར་ཐུག་པའི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00098",
      "source_tibetan": "འབད་ཅིང་རྩོལ་བ་མ་ཡིན་པས། །",
      "reading_tibetan": "འབད་ཅིང་རྩོལ་བ་མ་ཡིན་པས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00099",
      "source_tibetan": "གང་སུ་འཕྲད་པ་གྲོལ་བར་ངེས། །",
      "reading_tibetan": "གང་སུ་འཕྲད་པ་གྲོལ་བར་ངེས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00100",
      "source_tibetan": "དེས་ན་རྫོགས་ཆེན་བྱ་རྩོལ་བྲལ། །",
      "reading_tibetan": "དེས་ན་རྫོགས་ཆེན་བྱ་རྩོལ་བྲལ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00101",
      "source_tibetan": "གཞན་འབད་པ་ལས་བྱུང་བ་མིན། །",
      "reading_tibetan": "གཞན་འབད་པ་ལས་བྱུང་བ་མིན། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00102",
      "source_tibetan": "སངས་རྒྱས་བརྗོད་དུ་མེད་པ་ཡིས། །",
      "reading_tibetan": "སངས་རྒྱས་བརྗོད་དུ་མེད་པ་ཡིས། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00103",
      "source_tibetan": "ཡེ་ཐོག་ནས་ནི་ཕྱག་མཛད་པའི། །",
      "reading_tibetan": "ཡེ་ཐོག་ནས་ནི་ཕྱག་མཛད་པའི། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00104",
      "source_tibetan": "ཆོས་ཀྱི་སྐུ་ལ་ངེས་བརྒྱུད་དེ། །",
      "reading_tibetan": "ཆོས་ཀྱི་སྐུ་ལ་ངེས་བརྒྱུད་དེ། །",
      "status": "lexically_compared_punctuation_not_certified"
    },
    {
      "id": "U00105",
      "source_tibetan": "ལས་ཅན་སྣང་བར་བྱེད་དོན་དུ།",
      "reading_tibetan": "ལས་ཅན་སྣང་བར་བྱེད་དོན་དུ། །",
      "status": "scan_intervention"
    },
    {
